<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- =========================================================================
       Cutlance 主题层 · 现代科技深色
       ········································································
       ⚠ 为什么要这一层（2026-10-16 美化立项）：
         改造前全项目 12 个窗口共约 570 处硬编码色值、73 个不同色号，
         灰阶带 #0E0E0E~#4A4A4F 里挤了近 30 个几乎同色（#2A2A2C/#2A2A2D/#2A2A2E…），
         且 ScrollBar / ToolTip / CheckBox / Slider / ComboBox / GroupBox /
         GridViewColumnHeader 这些控件从未自绘过 → 深色界面里露出系统浅色控件。
         现在统一收敛成「一套调色板 + 一套控件模板」，各窗口只引用、不再写死色值。

       ⚠ 铁律：深色主题下 WPF 默认控件模板一律是浅色（系统色），
         仅设 Background 也不生效（模板里写死了系统色）→ 必须整套自绘。
         本文件已覆盖：Button / CheckBox / RadioButton / TextBox / PasswordBox /
         ComboBox / Slider / ScrollBar(横竖) / ListBoxItem / ListViewItem /
         GridViewColumnHeader / GroupBox / MenuItem / ContextMenu / ToolTip /
         StatusBar / Separator / ProgressBar。

       改配色：只改下方「调色板」段，全局同步生效。
       ========================================================================= -->

  <!-- ============================ 调色板（Colors）============================ -->
  <!-- 底色：略微偏蓝的中性灰，比原来的纯灰更"科技"、层次更清楚 -->
  <Color x:Key="Color.Bg.Base">#FF0F1218</Color>
  <Color x:Key="Color.Bg.Panel">#FF161C24</Color>
  <Color x:Key="Color.Bg.Surface">#FF1D242E</Color>
  <Color x:Key="Color.Bg.Raised">#FF252E3A</Color>
  <Color x:Key="Color.Bg.Sunken">#FF0A0E13</Color>
  <Color x:Key="Color.Bg.Overlay">#FF141B23</Color>
  <Color x:Key="Color.Bg.TitleBar">#FF131920</Color>
  <Color x:Key="Color.Bg.StatusBar">#FF0B0F14</Color>

  <!-- 描边 -->
  <Color x:Key="Color.Border">#FF2A3442</Color>
  <Color x:Key="Color.Border.Strong">#FF3A4757</Color>

  <!-- 文字 -->
  <Color x:Key="Color.Text">#FFE6ECF3</Color>
  <Color x:Key="Color.Text.Secondary">#FFA5B1C0</Color>
  <Color x:Key="Color.Text.Muted">#FF6E7B8B</Color>
  <Color x:Key="Color.Text.Disabled">#FF4A5563</Color>

  <!-- 强调与语义色（克制使用：只用于状态与主操作） -->
  <Color x:Key="Color.Accent">#FF3B9DFF</Color>
  <Color x:Key="Color.Accent.Hover">#FF5CB0FF</Color>
  <Color x:Key="Color.Accent.Press">#FF2A7FDB</Color>
  <Color x:Key="Color.Accent.Dim">#FF16334F</Color>
  <Color x:Key="Color.Pgm">#FFFF4D5E</Color>
  <Color x:Key="Color.Pgm.Dim">#FF3A1A20</Color>
  <Color x:Key="Color.Pvw">#FF33C6F5</Color>
  <Color x:Key="Color.Pvw.Dim">#FF102E3A</Color>
  <Color x:Key="Color.Gold">#FFF0B93B</Color>
  <Color x:Key="Color.Gold.Dim">#FF3A2F14</Color>
  <Color x:Key="Color.Warn">#FFFFA62B</Color>
  <Color x:Key="Color.Ok">#FF3BC97A</Color>
  <Color x:Key="Color.Ok.Dim">#FF12301F</Color>
  <Color x:Key="Color.Scroll.Thumb">#FF3A4757</Color>
  <Color x:Key="Color.Scroll.Thumb.Hover">#FF55677C</Color>
  <!-- 信息卡（"当前输入信号"这类青色调说明块） -->
  <Color x:Key="Color.Info.Bg">#FF16262A</Color>
  <Color x:Key="Color.Info.Border">#FF2A4A4A</Color>
  <Color x:Key="Color.Info.Text">#FFB2EBF2</Color>

  <!-- ============================ 画刷（Brushes）============================ -->
  <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Color.Bg.Base}"/>
  <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{StaticResource Color.Bg.Panel}"/>
  <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{StaticResource Color.Bg.Surface}"/>
  <SolidColorBrush x:Key="Brush.Bg.Raised" Color="{StaticResource Color.Bg.Raised}"/>
  <SolidColorBrush x:Key="Brush.Bg.Sunken" Color="{StaticResource Color.Bg.Sunken}"/>
  <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="{StaticResource Color.Bg.Overlay}"/>
  <SolidColorBrush x:Key="Brush.Bg.TitleBar" Color="{StaticResource Color.Bg.TitleBar}"/>
  <SolidColorBrush x:Key="Brush.Bg.StatusBar" Color="{StaticResource Color.Bg.StatusBar}"/>

  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>

  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}"/>
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>

  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
  <SolidColorBrush x:Key="Brush.Accent.Press" Color="{StaticResource Color.Accent.Press}"/>
  <SolidColorBrush x:Key="Brush.Accent.Dim" Color="{StaticResource Color.Accent.Dim}"/>
  <SolidColorBrush x:Key="Brush.Pgm" Color="{StaticResource Color.Pgm}"/>
  <SolidColorBrush x:Key="Brush.Pgm.Dim" Color="{StaticResource Color.Pgm.Dim}"/>
  <SolidColorBrush x:Key="Brush.Pvw" Color="{StaticResource Color.Pvw}"/>
  <SolidColorBrush x:Key="Brush.Pvw.Dim" Color="{StaticResource Color.Pvw.Dim}"/>
  <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}"/>
  <SolidColorBrush x:Key="Brush.Gold.Dim" Color="{StaticResource Color.Gold.Dim}"/>
  <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
  <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}"/>
  <SolidColorBrush x:Key="Brush.Ok.Dim" Color="{StaticResource Color.Ok.Dim}"/>
  <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{StaticResource Color.Scroll.Thumb}"/>
  <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="{StaticResource Color.Scroll.Thumb.Hover}"/>
  <SolidColorBrush x:Key="Brush.Info.Bg" Color="{StaticResource Color.Info.Bg}"/>
  <SolidColorBrush x:Key="Brush.Info.Border" Color="{StaticResource Color.Info.Border}"/>
  <SolidColorBrush x:Key="Brush.Info.Text" Color="{StaticResource Color.Info.Text}"/>
  <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>

  <!-- ============================ 度量与字体 ============================ -->
  <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Radius.Md">6</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">10</CornerRadius>
  <Thickness x:Key="Pad.Ctl">8,4</Thickness>
  <Thickness x:Key="Pad.Field">8,0</Thickness>

  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas, Courier New, monospace</FontFamily>
  <sys:Double x:Key="FontSize.Sm">11</sys:Double>
  <sys:Double x:Key="FontSize.Normal">12</sys:Double>
  <sys:Double x:Key="FontSize.Md">13</sys:Double>
  <sys:Double x:Key="FontSize.Lg">15</sys:Double>

