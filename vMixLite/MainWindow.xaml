<Window x:Class="Cutlance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cutlance"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:Cutlance.Views"
        Title="Cutlance" Height="860" Width="1340"
        Style="{StaticResource AppWindow}"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 按钮样式统一由主题层提供（Themes/Theme.xaml 的隐式 Button 样式）；
         这里保留 VmButton 作为「基于主题的透传别名」，避免改动几十处引用。 -->
    <Style x:Key="VmButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

    <!-- OVERLAYS 通道行：上线(有内容且可见)时高亮 + 用通道色描边 -->
    <Style x:Key="OverlayRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
          <Setter Property="BorderBrush" Value="{Binding ChannelBrush}"/>
          <Setter Property="BorderThickness" Value="1.6"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 图层行：被锁定为音频源时金色高亮描边 -->
    <Style x:Key="LayerRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAudioSource}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Gold.Dim}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
          <Setter Property="BorderThickness" Value="1.6"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Visible}" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 输入项缩略图 -->
    <Style x:Key="TileBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsProgram}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Pgm}"/>
          <Setter Property="BorderThickness" Value="2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPreview}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Pvw}"/>
          <Setter Property="BorderThickness" Value="2"/>
        </DataTrigger>
        <!-- 多选（Ctrl+点击）优先显示金色描边 -->
        <DataTrigger Binding="{Binding IsPicked}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
          <Setter Property="BorderThickness" Value="2"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="30"/>   <!-- 菜单条 -->
      <RowDefinition Height="*"/>     <!-- 主区 -->
      <RowDefinition Height="26"/>    <!-- 状态栏 -->
    </Grid.RowDefinitions>

    <!-- ===== 顶部菜单条 ===== -->
    <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
        <Rectangle Width="12" Height="12" Fill="{DynamicResource Brush.Pgm}" Margin="0,0,7,0"/>
        <!-- 老板 2026-10-20 第 1 条「安装后不要出现 vMixLite」：
             这里原来是拆成两个 TextBlock 写的 "vMix" + "Lite"，
             整词替换扫不到，是界面上一眼就能看见的旧名残留。 -->
        <TextBlock Text="Cutlance" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold" FontSize="15"/>
        <TextBlock Text="2.0" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="5,3,0,0"/>
      </StackPanel>
        <!-- 顶部菜单：每一项都链接到下方对应的操作按钮/功能 -->
        <Menu Grid.Column="1" x:Name="TopMenu" Background="Transparent" BorderThickness="0"
              VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0"
              Foreground="{DynamicResource Brush.Text.Secondary}">

          <!-- ===== 文件 ===== -->
          <MenuItem Header="文件">
            <MenuItem Header="新建工程" InputGestureText="Ctrl+N" Click="MenuNewProject_Click"/>
            <MenuItem Header="打开工程…" InputGestureText="Ctrl+Shift+O" Click="MenuOpenProject_Click"/>
            <MenuItem Header="保存工程" InputGestureText="Ctrl+S" Click="MenuSaveProject_Click"/>
            <MenuItem Header="工程另存为…（选保存目录）" InputGestureText="Ctrl+Shift+S" Click="MenuSaveProjectAs_Click"/>
            <MenuItem Header="打开工程所在目录" Click="MenuOpenProjectFolder_Click"/>
            <MenuItem x:Name="MiRecentProjects" Header="最近工程"/>
            <Separator/>
            <MenuItem Header="添加视频文件…" InputGestureText="Ctrl+O" Click="MenuAddFile_Click"/>
            <MenuItem Header="添加摄像头…" Click="MenuAddCamera_Click"/>
            <MenuItem Header="添加采集卡 / 摄像机信号…（先看信号格式）" Click="MenuAddCapture_Click"/>
            <MenuItem Header="添加网络流…（RTSP / SRT / RTMP / HTTP）" Click="MenuAddNetwork_Click"/>
            <MenuItem Header="添加 NDI 源…（局域网 NDI 发现）" Click="MenuAddNdi_Click"/>
            <MenuItem Header="添加桌面捕获" Click="MenuAddScreen_Click"/>
            <Separator/>
            <MenuItem Header="退出" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
          </MenuItem>

          <!-- ===== 编辑 ===== -->
          <MenuItem Header="编辑">
            <MenuItem Header="新建文字叠加" InputGestureText="Ctrl+T" Click="MenuNewText_Click"/>
            <MenuItem Header="新建图片叠加…" InputGestureText="Ctrl+I" Click="MenuNewImage_Click"/>
            <Separator/>
            <MenuItem Header="删除选中的叠加层" Click="MenuDeleteOverlay_Click"/>
            <MenuItem Header="清空全部叠加层" Click="MenuClearOverlays_Click"/>
            <Separator/>
            <MenuItem Header="把预览加入输出图层" InputGestureText="Ctrl+L" Click="MenuAddLayer_Click"/>
            <MenuItem Header="清空输出图层" Click="MenuClearLayers_Click"/>
          </MenuItem>

          <!-- ===== 视图 ===== -->
          <MenuItem x:Name="MiViewMenu" Header="视图">
            <MenuItem x:Name="MiShowPreview" Header="显示预览监视器" IsCheckable="True"
                      IsChecked="True" Click="MenuShowPreview_Click"/>
            <MenuItem x:Name="MiShowProgram" Header="显示输出监视器" IsCheckable="True"
                      IsChecked="True" Click="MenuShowProgram_Click"/>
            <!-- 单画面放大（2026-10-25）：两个方向各一项，互斥。 -->
            <MenuItem x:Name="MiZoomProgram" Header="放大输出画面（播的时候看清节目）" Click="MenuProgramZoom_Click"
                      ToolTip="把预览收起来、输出占满监视区。推流 / 录制中也能用"/>
            <MenuItem x:Name="MiZoomPreview" Header="放大预览画面（摆素材时精调）" Click="MenuPreviewZoom_Click"
                      ToolTip="把输出收起来、预览占满监视区。要求先停输出（否则等于盲播）"/>
            <Separator/>
            <!-- 分辨率：合成器的画面缓冲在启动时按尺寸分配，运行时改不了 →
                 这两项只「记下选择 + 存进工程」，重启程序后才真生效。
                 以前它们声称"已切换"，配上被静默拽回的输出，是假开关。
                 （2026-10-20 老板：「把输出设置里的相关功能都转到这里」——
                 原来「设置 → 输出设置 → 输出画面」里那一整块搬进本子菜单，
                  窗口里不再保留，避免同一个功能两处可改、两处说法不一致。） -->
            <MenuItem x:Name="MiResMenu" Header="输出分辨率（重启生效）" SubmenuOpened="MenuRes_SubmenuOpened">
              <MenuItem x:Name="MiResH" Header="1920 × 1080（横屏）" IsCheckable="True"
                        IsChecked="True" Tag="1920x1080" Click="MenuRes_Click"/>
              <MenuItem x:Name="MiResV" Header="1080 × 1920（竖屏）" IsCheckable="True"
                        Tag="1080x1920" Click="MenuRes_Click"/>
              <!-- 异形屏（2026-10-25）：LED 拼接屏 / 弧形屏的像素排布是工程方定的，
                   3840×1080、2560×1080、5760×1080 都常见。给一个常用档 + 一个自由输入，
                   比只留两档横竖屏实用得多（vMix 也是靠手填 Output Size 达成的）。 -->
              <MenuItem x:Name="MiResU" Header="3840 × 1080（32:9 超宽 LED）" IsCheckable="True"
                        Tag="3840x1080" Click="MenuRes_Click"/>
              <MenuItem Header="自定义尺寸…（异形屏）" Click="MenuResCustom_Click"
                        ToolTip="填任意宽高，如 3840x1080 / 2560x1080 / 5760x1080。选完需重启才换画面尺寸"/>
              <Separator/>
              <!-- 真实出图尺寸：选了竖屏但还没重启时，它仍是横屏 —— 必须和上面的勾选分开显示，
                   否则又是一层假象。IsHitTestVisible=False：读文案但点不着，不吃禁用态的灰。 -->
              <MenuItem x:Name="MiResNow" Header="当前画面：1920 × 1080（横屏）"
                        IsHitTestVisible="False" Focusable="False"
                        Foreground="{DynamicResource Brush.Text.Secondary}"/>
              <!-- 选完立刻给「现在就重启」的出口。没待生效项时收起。
                   文案固定「保存文件立即重启」——不跟横/竖屏变（老板 2026-10-20：
                   「只要选择另一个选项就弹出按钮『保存文件立即重启』，点击后保存当前文件然后重启」）。
                   文案跟着选择变会让人以为横屏和竖屏是两件事，其实动作完全一样：
                   存盘 → 用同一工程拉起新实例 → 关掉自己。 -->
              <MenuItem x:Name="MiResRestart" Header="保存文件立即重启" Visibility="Collapsed"
                        FontWeight="Bold" Foreground="{DynamicResource Brush.Warn}"
                        Click="MenuResRestart_Click"/>
              <Separator/>
              <MenuItem Header="合成器在启动时按尺寸分配画面缓冲，选完需重启才换画面尺寸"
                        IsHitTestVisible="False" Focusable="False"
                        Foreground="{DynamicResource Brush.Text.Muted}"/>
              <MenuItem Header="预览框 / 播出框按所选宽高比显示（自动加黑边居中），推流与录制文件锁定该分辨率"
                        IsHitTestVisible="False" Focusable="False"
                        Foreground="{DynamicResource Brush.Text.Muted}"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="MiFtb" Header="淡黑 FTB" IsCheckable="True" Click="MenuFtb_Click"/>
            <MenuItem Header="全屏 / 还原" InputGestureText="F11" Click="MenuFullscreen_Click"/>
            <Separator/>
            <!-- P4：内存合成的「监视窗 + 切换条」。成品帧在内存里，输出不依赖屏幕。 -->
            <MenuItem Header="打开切换台窗口（节目 / 预监）…" Click="MenuSynthWindow_Click"/>
            <Separator/>
            <!-- 老板 2026-10-19 第 1 条：文档（表格 / PPT）翻页。菜单里也放一份 ——
                 翻页笔 / 快捷键之外还有鼠标这条路，且不受焦点在哪个控件上的影响。 -->
            <MenuItem Header="文档翻页：下一页" InputGestureText="PageDown" Click="MenuDocNext_Click"/>
            <MenuItem Header="文档翻页：上一页" InputGestureText="PageUp" Click="MenuDocPrev_Click"/>
          </MenuItem>

          <!-- ===== 流 ===== -->
          <MenuItem Header="流">
            <!-- 「输出设置…」只保留在「设置」菜单里，避免同一入口出现两遍（老板 10-18 指出重复） -->
            <MenuItem x:Name="MiStartOutput" Header="开始推流 / 录制" Click="MenuStartOutput_Click"/>
            <MenuItem x:Name="MiStopOutput" Header="停止推流 / 录制" IsEnabled="False"
                      Click="MenuStopOutput_Click"/>
            <Separator/>
            <MenuItem x:Name="MiHdmi" Header="HDMI 全屏输出" IsCheckable="True" Click="MenuHdmi_Click"/>
          </MenuItem>

          <!-- ===== 设置 ===== -->
          <MenuItem x:Name="MiSetupMenu" Header="设置">
            <MenuItem Header="输出设置…（推流 / 录制 / HDMI / 引擎）" Click="MenuOutputSettings_Click"/>
            <MenuItem Header="摄像头采集设置…" Click="MenuCameraSettings_Click"/>
            <MenuItem Header="输入信号 / 采集设备…（采集卡 · 摄像机）" Click="MenuCaptureSignal_Click"/>
            <MenuItem Header="输入裁切 / 旋转…（对当前预览的输入）" Click="MenuInputGeometry_Click"/>
            <Separator/>
            <MenuItem Header="音频混音台…（8 路采集 / 音量）" Click="MenuAudioMixer_Click"/>
            <MenuItem Header="画面效果…（调色 / 美颜 / 美体）" Click="MenuVideoFx_Click"/>
            <MenuItem Header="倒计时 / 触发器…（到点自动执行动作）" Click="MenuCountdown_Click"/>
            <MenuItem Header="导播键盘 / 快捷键…（外设按键绑定）" InputGestureText="F9" Click="MenuHotkeys_Click"/>
            <!-- 老板 2026-10-21：这里原有「播放硬件解码」「推流/录制编码器 ×3」「播出保护 ×2」三组，已删。
                 前两组跟「输出设置…」里的是同一属性两个入口（同一属性两处可改 = 必出不一致），
                 权威入口只留输出设置窗那一份。
                 播出保护那两个勾在 P6 之后永远不会触发 —— 输出吃的是内存成品帧，不看屏幕，
                 合成器在跑时 BroadcastGuard.IsLive 恒 false。留着就是「勾了也没用」的骗人开关。
                 保护逻辑本身仍留在 BroadcastGuard 里，只在合成器起不来、退回抓屏兜底时自动生效，
                 不再对外暴露开关。 -->
          </MenuItem>

          <!-- ===== 帮助 ===== -->
          <MenuItem x:Name="MiHelpMenu" Header="帮助">
            <MenuItem Header="操作手册（怎么用）" Click="MenuManual_Click"/>
            <MenuItem Header="快捷键一览" Click="MenuShortcuts_Click"/>
            <Separator/>
            <MenuItem Header="这台电脑跑得动吗（性能评估）" Click="MenuPerfReport_Click"
                      ToolTip="看最近 10 分钟的实际占用：CPU / 内存够不够、本程序吃了多少、要不要升级电脑"/>
            <MenuItem Header="关于 Cutlance" Click="MenuAbout_Click"/>
            <!-- 打赏占位（老板 2026-10-21）：渠道与项目页后期再接，先占住位置。
                 灰显而不是隐藏 —— 让老板/用户知道「这里将来会有」，也不用改菜单结构。 -->
            <MenuItem x:Name="MiDonate" Header="打赏支持作者（敬请期待）" IsEnabled="False"
                      ToolTip="打赏渠道与项目主页将在后期版本接入"/>
            <Separator/>
            <MenuItem Header="打开错误日志目录" Click="MenuOpenLog_Click"/>
          </MenuItem>
        </Menu>
      <TextBlock Grid.Column="2" x:Name="ClockText" Text="--:--:--" Foreground="{DynamicResource Brush.Text.Secondary}"
                 VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
    </Grid>

    <!-- ===== 主区 ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="196"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="284"/>
      </Grid.ColumnDefinitions>

      <!-- 左：输入源面板 -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Bg.TitleBar}" Height="26">
            <TextBlock Text="输入 INPUTS" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0"/>
          </Grid>
          <!-- 用 WrapPanel 而非 StackPanel：输入源按钮会随功能增加，放不下时自动换行，
               不去改动左栏 212 的固定宽度（那会连带改小预览/输出监视器）。 -->
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddFile" Content="+文件" Width="62" Margin="2" Click="BtnAddFile_Click"/>
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddCamera" Content="+摄像头" Width="62" Margin="2" Click="BtnAddCamera_Click"/>
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddScreen" Content="+桌面" Width="62" Margin="2" Click="BtnAddScreen_Click"/>
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddCapture" Content="+采集卡" Width="62" Margin="2" Click="BtnAddCapture_Click"
                    ToolTip="采集卡 / 摄像机信号：先看设备支持的信号格式，再配置采集参数"/>
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddNetwork" Content="+网络流" Width="62" Margin="2" Click="BtnAddNetwork_Click"
                    ToolTip="网络流输入：RTSP / SRT / RTMP / HTTP(HLS) / RIST / UDP —— 粘地址即可，支持一次粘多条"/>
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddNdi" Content="+NDI" Width="62" Margin="2" Click="BtnAddNdi_Click"
                    ToolTip="NDI 输入：发现并接收局域网里的 NDI 源（用 NDI 官方 SDK 自收帧，不依赖 ffmpeg/VLC 各自的 NDI 能力）"/>
            <!-- 老板 2026-10-19 第 1 条：表格进预览，按 Excel 打印分页用 PageUp/PageDown 翻页 -->
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddExcel" Content="+表格" Width="62" Margin="2" Click="BtnAddExcel_Click"
                    ToolTip="表格进预览：按 Excel 自己的打印分页渲染成页图片，PageUp / PageDown 翻页"/>
            <!-- 老板 2026-10-19 第 1 条：PPT 进预览（抓放映窗口），翻页键直接投递给放映窗口 -->
            <Button Style="{StaticResource VmButton}" x:Name="BtnAddPpt" Content="+PPT" Width="62" Margin="2" Click="BtnAddPpt_Click"
                    ToolTip="PPT 进预览：全屏放映并抓那块屏幕，PageUp / PageDown 翻页（放映窗口要一直可见，不能被别的窗口挡住）"/>
          </WrapPanel>
          <!-- ===== 播放列表 PLAYLIST（模块 A：多素材自动顺播）=====
               放在输入面板下方：上方挑素材 → 「+加入预览源」进列表 → ▶ 开始自动连播。
               播放项在输出画布上用一个专属图层呈现，不影响用户自己摆的其它图层。 -->
          <Border x:Name="PlaylistPanel" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="0,1,0,0" Height="212">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Bg.TitleBar}" Height="26">
                <TextBlock Text="播放列表 PLAYLIST" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold"
                           FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                <!-- 折叠按钮（2026-10-25 布局整理）：不播列表时收起，省 186 DIP 给上面的输入列表 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                  <TextBlock x:Name="PlayStateText" Text="就绪" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Button x:Name="BtnPlayCollapse" Content="收起" Style="{StaticResource VmButton}"
                          Width="40" Height="18" FontSize="10" Padding="0" MinHeight="0"
                          Click="BtnPlayCollapse_Click"
                          ToolTip="收起 / 展开播放列表（收起后输入列表能多显示几行）"/>
                </StackPanel>
              </Grid>

              <DockPanel x:Name="PlaylistBody">
              <!-- 传输控制：开始 / 暂停 / 停止 / 上一项 / 下一项 -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,5,6,2">
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayStart"
                        Width="30" Height="24" Margin="1" Padding="0" MinHeight="0" Click="BtnPlayStart_Click"
                        ToolTip="开始播放列表（自动顺播）">
                  <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Play}"/>
                  </Button>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayPause"
                        Width="30" Height="24" Margin="1" Padding="0" MinHeight="0" Click="BtnPlayPause_Click"
                        ToolTip="暂停 / 继续（定时项剩余时间冻结）">
                  <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Pause}"/>
                  </Button>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayStop"
                        Width="30" Height="24" Margin="1" Padding="0" MinHeight="0" Click="BtnPlayStop_Click"
                        ToolTip="停止播放列表">
                  <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Stop}"/>
                  </Button>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayPrev"
                        Width="30" Height="24" Margin="1" Padding="0" MinHeight="0" Click="BtnPlayPrev_Click"
                        ToolTip="上一项">
                  <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Prev}"/>
                  </Button>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayNext"
                        Width="30" Height="24" Margin="1" Padding="0" MinHeight="0" Click="BtnPlayNext_Click"
                        ToolTip="下一项（直播源永不结束，用它手动推进）">
                  <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Next}"/>
                  </Button>
              </StackPanel>

              <!-- 增删：把当前 PREVIEW 加入列表 / 删除选中项 -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2">
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayAdd" Content="+ 加入预览源"
                        Width="122" Height="24" Margin="1" FontSize="11" Click="BtnPlayAdd_Click"
                        ToolTip="把左侧当前 PREVIEW 的那个输入加入播放列表"/>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayDel" Content="− 删除"
                        Width="60" Height="24" Margin="1" FontSize="11" Click="BtnPlayDel_Click"
                        ToolTip="从播放列表移除选中的那一项（不影响输入源本身）"/>
              </StackPanel>

              <!-- 选项：循环 / 给选中项设置播放时长 -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,3,6,4">
                <CheckBox x:Name="ChkPlayLoop" Content="循环" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"
                          VerticalAlignment="Center" Click="ChkPlayLoop_Click"
                          ToolTip="播完最后一项后回到第 1 项继续"/>
                <TextBlock Text="时长:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"
                           VerticalAlignment="Center" Margin="10,0,3,0"/>
                <TextBox x:Name="TxtPlayDur" Width="38" Height="20" FontSize="11" Text="5"
                         Background="{DynamicResource Brush.Bg.Base}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         KeyDown="TxtPlayDur_KeyDown"
                         ToolTip="选中列表项后填秒数 → 点「应用」；填 0 表示「播完自动下一项」"/>
                <Button Style="{StaticResource VmButton}" x:Name="BtnPlayDur" Content="应用"
                        Width="42" Height="22" Margin="3,0,0,0" FontSize="10"
                        Click="BtnPlayDur_Click"
                        ToolTip="把左侧秒数应用到选中的列表项（0 = 播完自动下一项）"/>
              </StackPanel>

              <!-- 列表本体：序号 / 名称 / 时长；当前播放项红框高亮；双击直接跳播 -->
              <ListBox x:Name="PlayListBox" Background="Transparent" BorderThickness="0"
                       Margin="6,0,6,6" SelectionMode="Single"
                       MouseDoubleClick="PlayListBox_MouseDoubleClick"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter/>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,3" Padding="4,3" CornerRadius="2" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.Bg.Overlay}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Pgm}"/>
                              <Setter Property="Background" Value="{DynamicResource Brush.Pgm.Dim}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="18"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Order}" Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </DockPanel><!-- PlaylistBody -->
            </DockPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4">
            <!-- 输入列表：按住任意输入项上下拖动即可调整顺序（老板 2026-10-19）。
                 松手后按新顺序重排编号 1..N —— 导播键盘「切到输入 N」是按列表次序取的，
                 编号与次序错位就会切错路。图层 / 播放列表 / 预览持有的都是对象引用，
                 重排不会打乱「哪一层在播哪一路」。 -->
            <ItemsControl x:Name="InputTiles"
                          AllowDrop="True"
                          DragOver="InputTiles_DragOver" Drop="InputTiles_Drop"
                          PreviewMouseLeftButtonDown="InputTiles_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="InputTiles_PreviewMouseMove">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="Tile_Click" Background="Transparent" BorderThickness="0"
                          Padding="0" Margin="0,0,0,6" Cursor="Hand">
                    <Button.ContextMenu>
                      <!-- ContextMenu 不在可视树里、不会自动继承 DataContext，
                           所以显式走 PlacementTarget（= 这个输入项）的 DataContext = 该输入源本身。
                           这样右键哪一路就改哪一路，不必先把它设成 PREVIEW。 -->
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                 RelativeSource={RelativeSource Self}}">
                        <!-- 老板 2026-10-23：点左侧文件只进预览、要上播出必须点「切换」。
                             所以"只换播出里某一格"改成这里的显式动作 —— 只有明确点它才动播出画面。 -->
                        <MenuItem Header="换入播出框选中的那一格" Click="TileSwapToSelectedLayer_Click"
                                  ToolTip="先在播出框里点中要换的那一格，再到这里右键点它。&#x0a;（点左侧文件本身只会进预览，不会动播出画面）"/>
                        <Separator/>
                        <!-- 老板 2026-10-20：「在左侧文件处鼠标右键 增加一个改名」——
                             文件名太长 / 认不出来（GATHER CAM2、camera 1…）时改成自己认得的名字。
                             只改显示名，不动文件本身、不动设备名。 -->
                        <MenuItem Header="改名…（这一路输入）" Click="TileRename_Click"/>
                        <MenuItem Header="裁切 / 旋转…（这一路输入）" Click="TileCrop_Click"/>
                        <Separator/>
                        <MenuItem Header="从列表中删除该输入" Click="TileDelete_Click"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Border Style="{StaticResource TileBorder}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
                          <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Brush.Text}"
                                     FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontSize="12"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding TypeShort}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                          <!-- 模块E B-2：采集输入的信号状态灯，常显。
                               采集链路的死活（USB 抖动 / 信号源断电 / 设备被抢走）必须一眼看到，
                               不该逼人开面板去查。只对采集类输入显示（文件/桌面没有「信号」一说）。 -->
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                      Visibility="{Binding CamStatusVisibility}">
                            <StackPanel.ToolTip>
                              <StackPanel>
                                <TextBlock Text="{Binding CamStatusText}"/>
                                <TextBlock Text="{Binding DeinterlaceSummary}"/>
                              </StackPanel>
                            </StackPanel.ToolTip>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding CamStatusBrush}"/>
                            <TextBlock Text="{Binding CamStatusText}" FontSize="9" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding CamStatusBrush}"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0">
                          <TextBlock Text="PGM" Foreground="{DynamicResource Brush.Pgm}" FontSize="9" FontWeight="Bold"
                                     Visibility="{Binding IsProgram, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="PVW" Foreground="{DynamicResource Brush.Pvw}" FontSize="9" FontWeight="Bold"
                                     Margin="3,0,0,0"
                                     Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="✓选" Foreground="{DynamicResource Brush.Gold}" FontSize="9" FontWeight="Bold"
                                     Margin="3,0,0,0"
                                     Visibility="{Binding IsPicked, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 中：监视器 + 制作条 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>    <!-- 监视器 -->
          <RowDefinition Height="Auto"/>  <!-- 制作条 -->
        </Grid.RowDefinitions>

        <!-- 监视器：Preview | Output（多图层画布） -->
        <Grid Grid.Row="0" Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PvwCol" Width="*"/>
            <ColumnDefinition x:Name="GoCol" Width="44"/>
            <ColumnDefinition x:Name="PgmCol" Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Preview -->
          <!-- 预览组的右键菜单（老板 2026-10-20）：
               「预览窗口调好后可以鼠标右键保存为新文件方便直接调用」——
               右键整个预览格子（含标题栏）就能存成独立 .vpreset 文件，下次载入即用。 -->
          <Grid Grid.Column="0" x:Name="PreviewCell">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="保存为布局文件…（存这套摆法）" Click="MenuPreviewSaveFile_Click"/>
                <MenuItem Header="载入布局文件…（直接调用）" Click="MenuPreviewLoadFile_Click"/>
                <Separator/>
                <MenuItem Header="重新分屏（整齐宫格）" Click="MenuPreviewResplit_Click"/>
                <MenuItem Header="放大预览（精调）" Click="MenuPreviewZoom_Click"/>
                <Separator/>
                <!-- 老板 2026-10-21 第 3 条：画面卡住/花屏时右键刷一下 -->
                <MenuItem Header="刷新画面（卡住 / 花屏时用）" Click="MenuRefreshPreview_Click"/>
              </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
              <RowDefinition Height="22"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Brush.Pvw.Dim}">
              <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="预览组" Foreground="{DynamicResource Brush.Pvw}" FontWeight="Bold" FontSize="12"/>
                  <TextBlock x:Name="PreviewNameText" Text="" Foreground="{DynamicResource Brush.Pvw}"
                             FontSize="11" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- 多路预览组合（老板 2026-10-17 第③条）：
                     可以往预览框里放多路、每路自己摆位置和大小，再一键整组推上输出框。
                     单路时这几个按钮用不到也不碍事。 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnPreviewPicked" Style="{StaticResource VmButton}" Content="多选一起进预览"
                          Width="88" Height="18" Padding="0" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="BtnPreviewPicked_Click"
                          ToolTip="先在左侧输入列表 Ctrl+点击勾选多个（金色✓选），再点这里 → 勾选的所有输入一起进预览框自动分屏，便于逐个调整"/>
                  <Button x:Name="BtnPreviewSave" Style="{StaticResource VmButton}" Content="保存"
                          Width="38" Height="18" Padding="0" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="BtnPreviewSave_Click"
                          ToolTip="把预览框当前这套摆法存成一个独立布局文件（.vpreset）——&#x0a;以后「载入布局文件」或双击这个文件就能直接调回来（预览框右键也有同一项）"/>
                  <Button x:Name="BtnPreviewZoom" Style="{StaticResource VmButton}" Content="放大"
                          Width="38" Height="18" Padding="0" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="BtnPreviewZoom_Click"
                          ToolTip="把预览画面放到最大，方便一格一格精调；再点一次（按钮变成「还原」）回到原布局。&#x0a;⚠ 推流 / 录制进行中不让放大：放大要盖住输出画面，推出去的画面会跟着变"/>
                  <Button x:Name="BtnPreviewResplit" Style="{StaticResource VmButton}" Content="分屏"
                          Width="38" Height="18" Padding="0" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="BtnPreviewResplit_Click"
                          ToolTip="把预览框里现有的几路按数量重新排成整齐宫格（会清掉手工摆位）"/>
                  <Button x:Name="BtnPreviewClear" Style="{StaticResource VmButton}" Content="清空"
                          Width="38" Height="18" Padding="0" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="BtnPreviewClear_Click" ToolTip="清空预览框（不影响已经推到输出框的画面）"/>
                  <Button x:Name="BtnPreviewToProgram" Style="{StaticResource VmButton}" Content="全部上输出"
                          Width="72" Height="18" Padding="0" MinHeight="0" FontSize="11"
                          Click="BtnPreviewToProgram_Click"
                          ToolTip="把预览框里摆好的所有画面（连同各自的位置与大小）一次性推到输出框"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="PreviewBox" Background="Black" BorderBrush="{DynamicResource Brush.Pvw}"
                    BorderThickness="2" Margin="0,2,0,0">
              <Grid>
                <!-- 画面走合成器（A 方案）：一张普通位图，不再是 HwndHost 原生子窗。
                     好处：能被 WPF 正常裁剪/叠描边，也不受"窗口被遮挡"影响。 -->
                <Image x:Name="PvwImage" Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 交互层透明：多路预览的摆位/选中框/缩放块都画在这里 -->
                <Canvas x:Name="PreviewCanvas" Background="Transparent" ClipToBounds="True"/>
              </Grid>
            </Border>
          </Grid>

          <!-- 中间切换箭头（= GO / 加为图层） -->
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="BtnGo" Style="{StaticResource VmButton}" Padding="0" MinHeight="0"
                    Width="38" Height="38" Click="BtnGo_Click"
                    ToolTip="把当前预览切到输出（GO）">
            <Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.ArrowRight}" Width="19" Height="19"/>
          </Button>
          </Grid>

          <!-- Output：多图层画布 -->
          <Grid Grid.Column="2" x:Name="ProgramCell">
            <!-- 输出框右键（老板 2026-10-21 第 3 条）：
                 画面卡住 / 花屏 / 从最小化恢复后停在旧帧，右键刷一下即可。
                 右键菜单不会打断导播（不是模态框），播出中也能用。 -->
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="放大输出画面（看清节目）" Click="MenuProgramZoom_Click"/>
                <Separator/>
                <MenuItem Header="刷新画面（卡住 / 花屏时用）" Click="MenuRefreshProgram_Click"/>
              </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
              <RowDefinition Height="22"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Brush.Pgm.Dim}">
              <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="输出" Foreground="{DynamicResource Brush.Pgm}" FontWeight="Bold" FontSize="12"/>
                  <TextBlock x:Name="ProgramNameText" Text="多图层" Foreground="{DynamicResource Brush.Pgm}"
                             FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- 单画面放大（2026-10-25 老板要）：
                     把预览收起来，输出占满整块监视区 —— 播的时候看清画面。
                     与预览标题栏那个「放大」区别：那个要求先停输出（看不到节目画面等于盲播），
                     这个**推流中照样能开**，因为它正是让你看到播出去的东西。 -->
                <Button x:Name="BtnProgramZoom" Content="放大" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource VmButton}" Width="44" Height="18" FontSize="10"
                        Padding="0" MinHeight="0" Click="BtnProgramZoom_Click"
                        ToolTip="放大输出画面（收起预览列）。推流 / 录制中也能用，播出不受影响；再点「还原」回双画面"/>
              </Grid>
            </Border>
            <!-- ProgramBorder：多图层画布外框（合成器出图；抓屏输出为兼容旧用法保留为可选） -->
            <Border Grid.Row="1" x:Name="ProgramBorder" Background="Black"
                    BorderBrush="{DynamicResource Brush.Pgm}" BorderThickness="2" Margin="0,2,0,0">
              <Grid>
                <!-- A 方案：节目画面 = 合成器成品帧（图层 + 叠加都在里面）。
                     Stretch=Fill 是必须的 —— 图层的归一化坐标要跟这块矩形严格同构，
                     用 Uniform 会留黑边，拖动手感就跟画面对不上了。 -->
                <Image x:Name="PgmImage" Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 交互层（透明）：图层选中框、缩放块、拖拽命中都由它和 Win32 钩子处理。
                     Canvas 上没有视频子窗了，所以不再需要 HwndClip 那套裁剪看护。 -->
                <Canvas x:Name="LayersCanvas" Background="Transparent"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- 制作条 -->
        <Border Grid.Row="1" x:Name="ProdBar" Background="{DynamicResource Brush.Bg.TitleBar}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="8,6">
          <StackPanel>
            <!-- 窄屏兜底：横向滚动，避免右侧 CUT/AUTO/FTB/图层 被裁掉
                 （紧凑模式会先收起「时长」组，多数情况连滚动条都不会出现） -->
            <ScrollViewer x:Name="TransRow" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="转场" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"
                         Margin="0,0,6,0" FontSize="12"/>
              <ComboBox x:Name="TransitionCombo" Width="135" SelectedIndex="0"
                        SelectionChanged="TransitionCombo_SelectionChanged">
                <ComboBoxItem Content="Cut 硬切"/>
                <ComboBoxItem Content="Fade 淡出"/>
                <ComboBoxItem Content="AlphaFade 交叉溶解"/>
              </ComboBox>
              <!-- 「时长」只有 Fade / AlphaFade 转场用得上；窄屏时由紧凑模式整体收起（省约 220 DIP 宽） -->
              <StackPanel x:Name="DurationGroup" Orientation="Horizontal">
              <TextBlock Text="时长" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"
                         Margin="12,0,4,0" FontSize="12"/>
              <Slider x:Name="DurationSlider" Width="120" Minimum="0.3" Maximum="3"
                      Value="1" TickFrequency="0.1" ValueChanged="DurationSlider_ValueChanged"/>
              <TextBlock x:Name="DurationText" Text="1.0s" Foreground="{DynamicResource Brush.Text}"
                         VerticalAlignment="Center" Margin="4,0,14,0" FontSize="12"/>
              </StackPanel>
              <!-- 中文为主 + 英文小字：中文让新手一眼看懂，英文对齐 vMix 教程与导播键盘键帽 -->
              <Button x:Name="BtnCut" Style="{StaticResource VmButton}"
                      Width="96" Height="34" Click="BtnCut_Click"
                      ToolTip="硬切（CUT）：立即切换，不走转场">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="硬切" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Text="CUT" FontSize="9" Opacity="0.6" Margin="5,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnTake" Style="{StaticResource VmButton}"
                      Width="96" Height="34" Click="BtnTake_Click"
                      ToolTip="自动（AUTO）：按上面选的转场方式与时长切换">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="自动" VerticalAlignment="Center"/>
                  <TextBlock Text="AUTO" FontSize="9" Opacity="0.6" Margin="5,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnFtb" Style="{StaticResource VmButton}"
                      Width="88" Height="34" Click="BtnFtb_Click"
                      ToolTip="淡黑（FTB，Fade To Black）：整屏淡出到黑再恢复">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="淡黑" VerticalAlignment="Center"/>
                  <TextBlock Text="FTB" FontSize="9" Opacity="0.6" Margin="5,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- ===== 缩放数字微调（老板 2026-10-18：手输 + 步进，精确到小数点后 2 位）=====
                   口径统一成「占框比例」：1.00 = 正好铺满画布。
                   预览槽的 Scale 本来就是这个口径；图层是 2 = 铺满，显示时 ÷2、提交时 ×2。
                   ⚠ 不用 TextChanged 提交（XAML 解析期赋值就会触发，控件还没建完）→ 走 Enter / 失焦。
                   放在转场这一行：这一行本来就短，第二行要留给组合预设。 -->
              <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="14,12,14,12"/>
              <TextBlock Text="预览缩放" Foreground="{DynamicResource Brush.Text.Secondary}"
                         VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
              <TextBox x:Name="PvScaleBox" Width="46" Height="22" Padding="0" FontSize="11"
                       TextAlignment="Center" VerticalContentAlignment="Center"
                       KeyDown="PvScaleBox_KeyDown" LostFocus="PvScaleBox_LostFocus"
                       ToolTip="当前选中那一路的缩放（1.00 = 正好铺满预览框，范围 0.10–4.00），可手输到小数点后两位"/>
              <Button x:Name="PvScaleMinus" Style="{StaticResource VmButton}" Content="−" Width="20" Height="22"
                      Padding="0" MinHeight="0" FontSize="12" Tag="-1" Click="PvScaleStep_Click"
                      ToolTip="缩小 0.01"/>
              <Button x:Name="PvScalePlus" Style="{StaticResource VmButton}" Content="+" Width="20" Height="22"
                      Padding="0" MinHeight="0" FontSize="12" Tag="1" Click="PvScaleStep_Click"
                      ToolTip="放大 0.01"/>
              <TextBlock Text="图层缩放" Foreground="{DynamicResource Brush.Text.Secondary}"
                         VerticalAlignment="Center" FontSize="11" Margin="14,0,4,0"/>
              <TextBox x:Name="PgmScaleBox" Width="46" Height="22" Padding="0" FontSize="11"
                       TextAlignment="Center" VerticalContentAlignment="Center"
                       KeyDown="PgmScaleBox_KeyDown" LostFocus="PgmScaleBox_LostFocus"
                       ToolTip="当前选中的输出图层缩放（1.00 = 正好铺满输出框，范围 0.10–4.00），可手输到小数点后两位"/>
              <Button x:Name="PgmScaleMinus" Style="{StaticResource VmButton}" Content="−" Width="20" Height="22"
                      Padding="0" MinHeight="0" FontSize="12" Tag="-1" Click="PgmScaleStep_Click"
                      ToolTip="缩小 0.01"/>
              <Button x:Name="PgmScalePlus" Style="{StaticResource VmButton}" Content="+" Width="20" Height="22"
                      Padding="0" MinHeight="0" FontSize="12" Tag="1" Click="PgmScaleStep_Click"
                      ToolTip="放大 0.01"/>
              <!-- 最小/最大值（老板 2026-10-18）：两个框共用同一口径，1.00 = 正好铺满；
                   超出范围会被钳到边界并回显，不会出现"看着 6.00、实际 4.00"的错位。 -->
              <TextBlock x:Name="ScaleRangeHint" Text="范围 0.10–4.00×" FontSize="10"
                         Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         ToolTip="预览缩放与图层缩放的可调范围（手输或 ± 步进都按这个范围钳制）"/>
            </StackPanel>
            </ScrollViewer>
            <!-- 注：OVERLAY 1-8 快捷通道条已移到右侧栏中部（老板 2026-10-17 要求），
                 见「右：叠加层 + 图层」区域里的 OverlayBusCard。 -->
            <!-- 音频混音台 / 画面效果 快捷入口 -->
            <ScrollViewer x:Name="QuickEntryRow" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnAudioMixer" Style="{StaticResource VmButton}"
                      Content="音频混音台（8 路采集）" Width="152" Height="26"
                      Click="BtnAudioMixer_Click" ToolTip="最多八路音频采集：选设备、独立音量、静音；混音后统一进推流与录制"/>
              <Button x:Name="BtnVideoFx" Style="{StaticResource VmButton}"
                      Content="画面效果（调色/美颜/美体）" Width="182" Height="26" Margin="4,0,0,0"
                      Click="BtnVideoFx_Click" ToolTip="调色 / 美白 / 磨皮 / 瘦身 / 拉长（编码器 = NVIDIA NVENC 时启用）"/>
              <!-- ===== 输出布局预设（P3，2026-10-22）=====
                   把输出框整套「槽位 + 每格绑定的输入」存下来，直播中一键换整套版面。
                   ⚠ 下拉选中**不会**立刻切：WPF 的 ComboBox 被滚轮滑过就会静默改选中项，
                     若选中即切换，滚动页面就可能把播出画面换掉 —— 必须点「切换」才生效。 -->
              <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="12,6,12,6"/>
              <TextBlock Text="输出布局" Foreground="{DynamicResource Brush.Text.Secondary}"
                         VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
              <ComboBox x:Name="LayoutCombo" Width="132" Height="26" FontSize="11"
                        SelectionChanged="LayoutCombo_SelectionChanged"
                        PreviewMouseWheel="LayoutCombo_PreviewMouseWheel"
                        ToolTip="存好的整套输出布局。选中只是挑一个，&#x0a;要真换上画面得点右边「切换」（防止滚轮误改播出画面）">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="BtnLayoutApply" Style="{StaticResource VmButton}" Content="切换"
                      Width="46" Height="26" Margin="4,0,0,0" Click="BtnLayoutApply_Click"
                      ToolTip="把选中那套布局整套换上输出框（上一套整组下线，旧画面不会留在底下）"/>
              <Button x:Name="BtnLayoutSave" Style="{StaticResource VmButton}" Content="存"
                      Width="34" Height="26" Margin="4,0,0,0" Click="BtnLayoutSave_Click"
                      ToolTip="把输出框现在这一整套摆法（含每格绑定的输入、每格的音频开关、当前转场类型与时长）存成布局；&#x0a;选中的名字已存在就覆盖它"/>
              <Button x:Name="BtnLayoutDelete" Style="{StaticResource VmButton}" Content="删"
                      Width="34" Height="26" Margin="4,0,0,0" Click="BtnLayoutDelete_Click"
                      ToolTip="删掉选中这个布局（不影响当前画面）"/>
              <Button x:Name="BtnLayoutExport" Style="{StaticResource VmButton}" Content="导出"
                      Width="46" Height="26" Margin="4,0,0,0" Click="BtnLayoutExport_Click"
                      ToolTip="把选中这套布局导成一个 .clayout 文件，可以发给别人或存进素材盘"/>
              <Button x:Name="BtnLayoutImport" Style="{StaticResource VmButton}" Content="导入"
                      Width="46" Height="26" Margin="4,0,0,0" Click="BtnLayoutImport_Click"
                      ToolTip="读入别人给的 .clayout，加进本机布局列表（重名自动加后缀，不覆盖你已有的）"/>
              <Button x:Name="BtnLayoutUndo" Style="{StaticResource VmButton}" Content="撤回"
                      Width="46" Height="26" Margin="4,0,0,0" Click="BtnLayoutUndo_Click"
                      ToolTip="切错了点这里：回到切之前的那套画面&#x0a;（只记最近一次切换，再往前没有）"/>
              <TextBlock x:Name="AudioFxHint" Text="" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"
                         VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 右：叠加层 + 图层 -->
      <Border Grid.Column="2" Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <!-- x:Name：给「图层区放大」用（2026-10-23）。上面三块折叠掉，图层区就能占满右栏。
                 为什么不做可拖动分隔条：Row0 和 Row5 之间夹着两行 Auto（通道条 / 叠加项编辑器），
                 GridSplitter 拖不动 Auto 行；要真拖动就得重排全部 Grid.Row 序号，风险大于收益。 -->
            <RowDefinition x:Name="OverlayRow" Height="1*"/>     <!-- 叠加层 OVERLAYS：编辑器已移出，通道列表能多显示几行 -->
            <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
            <RowDefinition x:Name="OverlayStripRow" Height="Auto"/>   <!-- OVERLAY 快捷通道条 1-8（2026-10-17 从制作条移来） -->
            <RowDefinition x:Name="OverlayEditorRow" Height="Auto"/>   <!-- 选中叠加项编辑器（2026-10-18 下移：选中哪个通道就在下方编辑） -->
            <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
            <!-- 倒计时牌（2026-10-24）：固定高度、不被「图层区放大」折叠 —— 导播中随时要看剩多久 -->
            <RowDefinition x:Name="CountdownRow" Height="Auto"/>
            <RowDefinition Height="1.3*"/>   <!-- 图层 LAYERS（2026-10-22 提高：每行加了音量滑杆，要能看全 4 格） -->
            <RowDefinition Height="Auto"/>   <!-- 精调面板（2026-10-18：就地改 X/Y/宽高/描边/旋转/裁切） -->
          </Grid.RowDefinitions>

          <!-- 上：叠加层 OVERLAYS (1-8) —— 通道列表占满整行向下撑满；编辑器在列表下方、从左缘起占满整行 -->
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>     <!-- 标题 -->
              <RowDefinition Height="Auto"/>   <!-- +文字/+图片 -->
              <RowDefinition Height="*"/>      <!-- 通道列表：向下撑满剩余空间 -->
              <RowDefinition Height="Auto"/>   <!-- 层级说明（老板 2026-10-17） -->
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
              <TextBlock Text="叠加层 OVERLAYS（1 = 最上层）" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="10,0"/>
            </Grid>
            <!-- 老板 2026-10-19 21:06：
                 ①「+字幕表」从左侧移到这儿 —— 它产出的本来就是叠加层，跟 +文字 / +图片 放一起才顺手；
                 ②「清空所选」改名为「清空」。
                 用 WrapPanel 而不是 StackPanel：右栏窄，四个按钮一行放不下要能自动换行。 -->
            <WrapPanel Grid.Row="1" Margin="8,6">
              <Button Style="{StaticResource VmButton}" x:Name="BtnAddText" Content="+文字"
                      Width="72" Margin="2" Click="BtnAddText_Click"/>
              <Button Style="{StaticResource VmButton}" x:Name="BtnAddImg" Content="+图片"
                      Width="72" Margin="2" Click="BtnAddImg_Click"/>
              <!-- 老板 2026-10-19 第 3 条：按住 Ctrl 可多选叠加层，一次把它们全清空 -->
              <Button Style="{StaticResource VmButton}" x:Name="BtnClearSelOverlays" Content="清空"
                      Width="56" Margin="2" Click="BtnClearSelOverlays_Click"
                      ToolTip="有选中 → 清空选中的那几路（按住 Ctrl / Shift 可多选）；&#x0a;什么都没选 → 清空全部 8 路叠加"/>
              <Button Style="{StaticResource VmButton}" x:Name="BtnAddSubTable" Content="+字幕表"
                      Width="84" Margin="2" Click="BtnAddSubTable_Click"
                      ToolTip="字幕表：选一张 xlsx，表头下每一行做一条字幕条（第 1 列大字 / 第 2 列小字），&#x0a;按 PageUp / PageDown 一条条翻上屏。一次导入整张表 = 几十上百条字幕全备好"/>
              <!-- 老板 2026-10-19 21:42 第 2 条「字幕条没法翻页换」：
                   光靠 PageDown 不可靠（焦点在列表/滚动区时会被吃掉），所以给一组能点的按钮。
                   这两个按钮只管字幕表，绝不会误翻到 PPT / 表格上。 -->
              <Button Style="{StaticResource VmButton}" x:Name="BtnSubPrev" Content="◀" Width="34" Margin="2"
                      Click="BtnSubPrev_Click" ToolTip="字幕表：上一条（等同 PageUp）"/>
              <Button Style="{StaticResource VmButton}" x:Name="BtnSubNext" Content="▶" Width="34" Margin="2"
                      Click="BtnSubNext_Click" ToolTip="字幕表：下一条（等同 PageDown）"/>
              <Button Style="{StaticResource VmButton}" x:Name="BtnSubStyle" Content="字幕样式"
                      Width="80" Margin="2" Click="BtnSubStyle_Click"
                      ToolTip="调字幕条的大小 / 位置 / 文字颜色（改完立刻重新生成所有字幕条）"/>
            </WrapPanel>
            <!-- 通道列表：按住条目上下拖动即可换层级（老板 2026-10-17「1-8 可以上下拉动调换位置」）。
                 用标准 WPF 拖放实现；拖动结束后按新顺序重排 ChannelIndex ——
                 位置 1 永远是最上层，编号 / 通道色 / 输出画面的层级三者保持一致。 -->
            <ListBox Grid.Row="2" x:Name="OverlayList" Background="Transparent" BorderThickness="0"
                     Margin="8,4" MinHeight="96" SelectionChanged="OverlayList_SelectionChanged"
                     SelectionMode="Extended"
                     AllowDrop="True" DragOver="OverlayList_DragOver" Drop="OverlayList_Drop"
                     PreviewMouseLeftButtonDown="OverlayList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="OverlayList_PreviewMouseMove">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource OverlayRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- 通道色条（始终按通道色显示）-->
                      <Rectangle Grid.Column="0" Fill="{Binding ChannelBrush}"
                                 VerticalAlignment="Stretch"/>
                      <!-- 通道号 -->
                      <Border Grid.Column="1" Background="{DynamicResource Brush.Bg.Sunken}">
                        <TextBlock Text="{Binding ChannelIndex}" Foreground="{Binding ChannelBrush}"
                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      <CheckBox Grid.Column="2" IsChecked="{Binding Visible, Mode=TwoWay}"
                                IsEnabled="{Binding HasContent}"
                                VerticalAlignment="Center" Margin="6,0,6,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                 Foreground="{DynamicResource Brush.Text}" FontSize="12" VerticalAlignment="Center"
                                 Margin="34,0,0,0" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="3" Width="22" Height="20" Style="{StaticResource BtnIcon}"
                              Background="Transparent" BorderThickness="0"
                              Click="OverlayDelete_Click" Margin="2,0,2,0" ToolTip="删除该叠加层">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Brush.Pgm}" Width="12" Height="12"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- 层级说明：老板要的「1 在最上层」写清楚，并提示可以拖动换层。
                 ⚠ 保持单行（TextTrimming）：矮屏下多占一行就会把通道列表挤到只剩 1 项，没法拖。 -->
            <TextBlock Grid.Row="3" Margin="10,0,10,2" FontSize="10" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       ToolTip="数字 = 层级：1 在最上层（盖住下面的）。按住条目上下拖动能调换层级。"
                       Text="数字 = 层级，1 最上层 · 按住条目上下拖动可换层"/>

            <!-- 选中叠加项编辑器已下移到 OVERLAY 通道条下方（老板 2026-10-18 第 5 条）：
                 让通道列表多显示几行，选中第几个通道就在按钮条下面直接编辑它。 -->
          </Grid>

          <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource Brush.Border}"/>

          <!-- 中：OVERLAY 快捷通道条（1-8）
               —— 原挂在制作条第二行；老板 2026-10-17 要求移到右侧栏中部，把「图层」往下压。
               8 个按钮改用 UniformGrid 均分列宽：右侧栏固定 300 DIP，横排不会溢出，
               也不会像固定 Width 那样在极端 DPI 下被裁掉。 -->
          <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface}" Padding="8,7">
            <StackPanel>
              <!-- 标题行右侧加「编辑」折叠按钮（2026-10-25 布局整理）：
                   叠加项编辑区常驻会把下面的通道列表挤到一行都看不见，
                   而列表才是「现在到底叠了什么」的全局视图。默认收起，改文字时再展开。 -->
              <Grid>
                <TextBlock x:Name="OvBusLabel" Text="OVERLAY 叠加通道 (1-8)"
                           Foreground="{DynamicResource Brush.Text}" FontWeight="Bold" FontSize="11"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnOverlayEdit" Content="收起" HorizontalAlignment="Right"
                        Style="{StaticResource VmButton}" Width="46" Height="20" FontSize="10"
                        Padding="0" MinHeight="0" Click="BtnOverlayEdit_Click"
                        ToolTip="展开 / 收起「选中叠加项编辑」区（文字内容 / 字体 / 颜色 / 位置）。收起后通道列表能多显示几行"/>
              </Grid>
              <TextBlock x:Name="OvBusHint" Text="点击通道切换对应叠加层显示/隐藏；亮色 = 已叠加到输出"
                         Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"
                         TextWrapping="Wrap" Margin="0,3,0,6"/>
              <UniformGrid Rows="1" Columns="8">
                <Button x:Name="BtnOv1" Style="{StaticResource VmButton}" Content="1" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv2" Style="{StaticResource VmButton}" Content="2" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv3" Style="{StaticResource VmButton}" Content="3" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv4" Style="{StaticResource VmButton}" Content="4" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv5" Style="{StaticResource VmButton}" Content="5" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv6" Style="{StaticResource VmButton}" Content="6" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv7" Style="{StaticResource VmButton}" Content="7" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
                <Button x:Name="BtnOv8" Style="{StaticResource VmButton}" Content="8" Height="26"
                        Margin="1,0" Click="OverlayCh_Click"/>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- 选中叠加项编辑器（老板 2026-10-18 第 5 条：从叠加层区下移到通道条下方）
               · 文字叠加：显示文字 / 字体 / 字号 / 颜色组
               · 图片叠加：隐藏文字组，改为「图片整体大小」（第 7 条）
               · 位置 X/Y 两者共用（第 7 条：图片也要能上下左右移动） -->
          <Border Grid.Row="3" x:Name="OverlayEditor" IsEnabled="True" Margin="10,4,10,4"
                  Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5"
                  CornerRadius="3" Padding="8" MaxHeight="160">
            <!-- 2026-10-22：MaxHeight 230 → 160。这个编辑器是 Auto 高度，展开后把下面
                 「图层」区挤到只剩 1 行多 —— 而图层行现在带音量滑杆，必须能看全 4 格。
                 内容超过 160 就在框内滚动，不影响编辑。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="EdHeader" Text="选中叠加项编辑" Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="2" FontWeight="Bold"/>

                <!-- 老板 2026-10-19 22:15：「通道编辑也不能动字幕条了」——
                     选中字幕表占用的那一路时，位置 / 缩放滑块锁定，只留这句说明。 -->
                <TextBlock x:Name="EdLockHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,2,2,4"
                           FontSize="11" Foreground="{DynamicResource Brush.Accent}"
                           Text="这一路是字幕表：位置和大小请在「字幕样式」里调（本栏的位置 / 缩放已锁定，免得翻页时字幕条跑位）。"/>

                <!-- ===== 文字专属（图片叠加时整组隐藏）===== -->
                <StackPanel x:Name="EdTextGroup">
                  <TextBlock Text="文字内容" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                  <TextBox x:Name="EdText" Margin="2" TextChanged="EdText_TextChanged"
                           BorderBrush="{DynamicResource Brush.Border.Strong}"/>
                  <TextBlock Text="字体（系统已安装的全部字体）" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                  <ComboBox x:Name="EdFontFamily" Margin="2" Background="{DynamicResource Brush.Bg.Surface}"
                            SelectionChanged="EdFontFamily_SelectionChanged"/>
                  <StackPanel Orientation="Horizontal" Margin="2">
                    <CheckBox x:Name="EdBold" Content="粗体" Foreground="{DynamicResource Brush.Text.Secondary}"
                              Checked="EdBold_Changed" Unchecked="EdBold_Changed" Margin="0,0,12,0"/>
                    <CheckBox x:Name="EdItalic" Content="斜体" Foreground="{DynamicResource Brush.Text.Secondary}"
                              Checked="EdItalic_Changed" Unchecked="EdItalic_Changed"/>
                  </StackPanel>
                  <TextBlock Text="字号" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                  <Slider x:Name="EdFont" Minimum="12" Maximum="140" Value="36"
                          ValueChanged="EdFont_ValueChanged"/>
                  <TextBlock Text="颜色" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                  <ComboBox x:Name="EdColor" Margin="2"
                            SelectionChanged="EdColor_SelectionChanged">
                    <ComboBoxItem Content="白" Tag="#FFFFFFFF"/>
                    <ComboBoxItem Content="黄" Tag="#FFFFFF00"/>
                    <ComboBoxItem Content="红" Tag="#FFFF5252"/>
                    <ComboBoxItem Content="绿" Tag="#FF4CAF50"/>
                    <ComboBoxItem Content="黑" Tag="#FF000000"/>
                  </ComboBox>
                </StackPanel>

                <!-- ===== 图片专属（文字叠加时整组隐藏）===== -->
                <StackPanel x:Name="EdImgGroup" Visibility="Collapsed">
                  <TextBlock Text="图片整体大小 %（100 = 等比铺满输出框，不裁切）"
                             Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2" TextWrapping="Wrap"/>
                  <TextBlock x:Name="EdImgScaleVal" Text="100%"
                             Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="2,0,2,0"/>
                  <Slider x:Name="EdImgScale" Minimum="10" Maximum="300" Value="100"
                          ValueChanged="EdImgScale_ValueChanged"/>
                </StackPanel>

                <!-- ===== 位置（文字 / 图片共用）===== -->
                <TextBlock Text="水平位置 %（左右）" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                <Slider x:Name="EdX" Minimum="0" Maximum="100" Value="50"
                        ValueChanged="EdX_ValueChanged"/>
                <TextBlock Text="垂直位置 %（上下）" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2"/>
                <Slider x:Name="EdY" Minimum="0" Maximum="100" Value="90"
                        ValueChanged="EdY_ValueChanged"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Rectangle Grid.Row="4" Height="2" Fill="{DynamicResource Brush.Border}"/>

          <!-- 倒计时牌（2026-10-24 老板要求）：放在图层区上面。
               · 「设定」自由输入时长（默认一小时）；「恢复」回到设定的那个时间；
               · 「开始」后一直走，过了 0 继续走负数（显示成红色 = 超时多久），直到「停止」；
               · 「叠加」= 把数字写进输出画面（走合成器叠加，推流/录制/NDI/全屏都带），
                 不是界面上画一块 —— 界面上画的东西传不出去（铁律 12）；
               · 「字号」只影响叠加到画面上的大小（40–300，按 1080p 基准等比换算）。 -->
          <Border Grid.Row="5" Background="{DynamicResource Brush.Bg.Surface}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Padding="8,5,8,7">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⏱ 倒计时" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold" FontSize="11"
                           VerticalAlignment="Center"/>
                <!-- 字体/颜色（2026-10-24）：默认收起，省右栏高度；点开才露出字体下拉与颜色两行 -->
                <Button Grid.Column="1" x:Name="CdStyleBtn" Content="样式" Width="38" Height="18" FontSize="10"
                        Margin="6,0,0,0" Padding="0" VerticalAlignment="Center" Click="CdStyle_Click"
                        ToolTip="字体 / 粗斜体 / 文字颜色 / 底板颜色（只影响叠加到画面上的那块数字）"/>
                <TextBlock Grid.Column="3" x:Name="CdTimeText" Text="1:00:00" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text}"
                           ToolTip="剩余时间；前面带「-」= 已经超时多久（不会自动停，点「停止」才停）"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="CdSetBtn" Content="设定" Width="41" Height="22" FontSize="10" Margin="0,0,3,0"
                        Click="CdSet_Click"
                        ToolTip="自由输入倒计时时长：1:00:00（时分秒）/ 30:00（分:秒）/ 90（分钟）/ 45s（秒）"/>
                <Button x:Name="CdStartBtn" Content="开始" Width="41" Height="22" FontSize="10" Margin="0,0,3,0"
                        Click="CdStart_Click" ToolTip="从设定的时间开始往下走"/>
                <Button x:Name="CdStopBtn" Content="停止" Width="41" Height="22" FontSize="10" Margin="0,0,3,0"
                        Click="CdStop_Click" ToolTip="停在当前读数（负数也停住，方便看超时了多久）"/>
                <Button x:Name="CdRestoreBtn" Content="恢复" Width="41" Height="22" FontSize="10" Margin="0,0,3,0"
                        Click="CdRestore_Click" ToolTip="读数恢复成设定的那个时间（并停表）"/>
                <Button x:Name="CdOverlayBtn" Content="叠加" Width="41" Height="22" FontSize="10" Margin="0,0,3,0"
                        Click="CdOverlay_Click"
                        ToolTip="把倒计时数字叠进输出画面（推流 / 录制 / NDI / 全屏都会带上）。再点一次取消叠加">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VmButton}">
                      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    </Style>
                  </Button.Style>
                </Button>
                <Button x:Name="CdCenterBtn" Content="居中" Width="41" Height="22" FontSize="10"
                        Click="CdCenter_Click"
                        ToolTip="把叠加的数字放回画面正中（也可以直接在输出框里按住数字拖到想要的位置）"/>
              </StackPanel>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字号" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                <Slider Grid.Column="1" x:Name="CdFontSlider" Minimum="40" Maximum="300" Value="120"
                        SmallChange="5" LargeChange="20" Height="14" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" ValueChanged="CdFont_ValueChanged"
                        ToolTip="叠加到画面上的数字大小（1080p 下的像素高度；竖屏按短边等比换算）"/>
                <TextBlock Grid.Column="2" x:Name="CdFontText" Text="120" FontSize="10" MinWidth="24"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}"/>
              </Grid>

              <!-- 样式（2026-10-24 老板「做字体/颜色自定义」）：默认收起。
                   交互与 8 路叠加层的文字编辑器保持一致（字体下拉 = 系统全部字体，颜色给色板），
                   老板不用学第二套。字号上面那根滑杆管大小，这里只管"长什么样"。 -->
              <StackPanel x:Name="CdStyleRows" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="字体" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                  <ComboBox Grid.Column="1" x:Name="CdFontFamily" Height="22" FontSize="11" Margin="0,0,4,0"
                            Background="{DynamicResource Brush.Bg.Surface}"
                            SelectionChanged="CdFontFamily_Changed"
                            ToolTip="叠加数字用的字体（系统里装了的都在里面）。换字体后块宽会变，位置仍按拖过的地方摆"/>
                  <CheckBox Grid.Column="2" x:Name="CdBold" Content="粗" FontSize="10" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0"
                            Checked="CdFontStyle_Changed" Unchecked="CdFontStyle_Changed"/>
                  <CheckBox Grid.Column="3" x:Name="CdItalic" Content="斜" FontSize="10" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Checked="CdFontStyle_Changed" Unchecked="CdFontStyle_Changed"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="字色" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                  <ComboBox Grid.Column="1" x:Name="CdColor" Height="22" FontSize="11" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Bg.Surface}"
                            SelectionChanged="CdColor_Changed"
                            ToolTip="数字本身的颜色（超时那一刻另有专用的警示红）">
                    <ComboBoxItem Content="白" Tag="#FFFFFFFF"/>
                    <ComboBoxItem Content="黄" Tag="#FFFFEB3B"/>
                    <ComboBoxItem Content="橙" Tag="#FFFF9800"/>
                    <ComboBoxItem Content="红" Tag="#FFFF5252"/>
                    <ComboBoxItem Content="绿" Tag="#FF4CAF50"/>
                    <ComboBoxItem Content="青" Tag="#FF00E5FF"/>
                    <ComboBoxItem Content="蓝" Tag="#FF448AFF"/>
                    <ComboBoxItem Content="黑" Tag="#FF000000"/>
                    <ComboBoxItem Content="超时红" Tag="#FFFF5A5A"/>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Text="底板" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                  <ComboBox Grid.Column="3" x:Name="CdBack" Height="22" FontSize="11"
                            Background="{DynamicResource Brush.Bg.Surface}"
                            SelectionChanged="CdBack_Changed"
                            ToolTip="数字后面那块底衬：半透明黑最通用；画面干净时也可以选「无底板」">
                    <ComboBoxItem Content="半透黑" Tag="#66000000"/>
                    <ComboBoxItem Content="较黑" Tag="#A6000000"/>
                    <ComboBoxItem Content="实黑" Tag="#FF000000"/>
                    <ComboBoxItem Content="半透白" Tag="#66FFFFFF"/>
                    <ComboBoxItem Content="无底板" Tag="#00000000"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 下：图层 LAYERS -->
          <DockPanel Grid.Row="6" LastChildFill="True">
            <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Bg.TitleBar}" Height="26">
              <TextBlock Text="图层 LAYERS（画中画/分屏）" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Left"/>
              <!-- 图层区放大（2026-10-23）：四宫格时把上面叠加层区折叠掉，图层全列出来不用滚。
                   老板 2026-10-22 反馈「加滑杆后要滚三次」，这是最省事的解法（不重排行结构）。 -->
              <Button x:Name="BtnLayersExpand" Style="{StaticResource BtnIcon}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="54" Height="22" Margin="0,0,6,0" Padding="0"
                      Click="BtnLayersExpand_Click"
                      ToolTip="把上面的叠加层区折叠起来，让图层列表占满右栏 —— 四宫格不用滚动就能看全。&#x0a;再点一次还原。">
                <TextBlock x:Name="LayersExpandText" Text="收起上面" FontSize="10"/>
              </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Margin="8,6">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource VmButton}" x:Name="BtnAddLayer"
                        Width="150" Margin="2" Click="BtnAddLayer_Click">
                  <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.ArrowRight}" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock Text="把预览加入图层" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource VmButton}" x:Name="BtnClearLayers"
                        Content="清空图层" Width="80" Margin="2" Click="BtnClearLayers_Click"/>
              </StackPanel>
              <!-- 多选一起进预览：Ctrl+点击左侧输入项勾选多个，再点这里一次排成预览分屏。
                   老板 2026-10-19 23:24：「这里应该是多选一起进预览，操作也是进预览」
                   —— 原来这按钮是直接铺到输出框、跳过预览，导播前想核对一眼都不行。
                   现在统一走预览：先在这里看好摆位，再由「把预览加入图层 / 全部上输出」推上去。 -->
              <Button Style="{StaticResource VmButton}" x:Name="BtnAddPicked"
                      Width="234" Height="26" Margin="2,4,2,0" Click="BtnPickedToPreview_Click"
                      ToolTip="先在左侧输入列表里 Ctrl+点击勾选多个（金色✓选），再点此按钮：按数量自动分屏摆进预览框（不会直接上输出）">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Grid}" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock Text="多选一起进预览（Ctrl+点选）" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>
            <ListBox x:Name="LayerList" Background="Transparent" BorderThickness="0"
                     Margin="8,4" MinHeight="150">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LayerRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text}"
                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      <!-- 2026-10-22：勾选框从"名称上面一行"挪到名称左边，整行从 3 行文字压到 2 行
                           （66 → 46 DIP）。右栏只有 300 DIP 宽，图层行带音量滑杆后必须省高度，
                           否则四宫格要来回滚。 -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Grid.Column="0" IsChecked="{Binding Visible, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,4,0"
                                    ToolTip="勾上 = 这一格在输出框里显示"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text}"
                                     FontSize="12" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <!-- 类型 + 声音摘要（2026-10-23 老板：「把右下的单独声音大小控制合并进混音台一起处理」）
                             —— 这一行原来是一根音量滑杆，和混音台里的"画面声音"改的是同一个值，
                                两处都能拖反而让人怀疑"拖了到底哪边生效"。现在只显示结果「主音 · 100%」，
                                要调就点右边的「调音」进混音台（那里面有主次 + 音量 + 静音，一处调完）。 -->
                        <Grid Margin="0,1,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding TypeShort}" Foreground="{DynamicResource Brush.Text.Muted}"
                                     FontSize="10" VerticalAlignment="Center" MinWidth="26"/>
                          <TextBlock Grid.Column="1" Text="{Binding RoleVolumeText}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                     FontSize="10" VerticalAlignment="Center" Margin="4,0,2,0"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding VolumeDetail}"/>
                          <Button Grid.Column="2" Content="调音" FontSize="10" Padding="5,1" MinWidth="34"
                                  VerticalAlignment="Center" Click="LayerOpenMixer_Click"
                                  ToolTip="到「音频混音台 → 画面声音」里调这一格的主次与音量（与其它几路一起混）">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource VmButton}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </StackPanel>
                      <!-- 音频方块：点击锁定该层声音（变色+金边） -->
                      <Button Grid.Column="2" Width="26" Height="22" Margin="3,0"
                              BorderBrush="{DynamicResource Brush.Bg.StatusBar}" BorderThickness="1"
                              Click="LayerAudio_Click" ToolTip="锁定该图层声音输出">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Volume}" Width="12" Height="12"/>
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource VmButton}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAudioSource}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Gold}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Bg.Base}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <!-- 删除 -->
                      <Button Grid.Column="3" Width="22" Height="20" Style="{StaticResource BtnIcon}"
                              Background="Transparent" BorderThickness="0"
                              Click="LayerDelete_Click" Margin="2,0,2,0" ToolTip="删除该图层">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Brush.Pgm}" Width="12" Height="12"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- 精调面板（老板 2026-10-18）：默认停靠在右栏底部，只占一行标题；
               展开后可改选中那一路的 X/Y、宽/高、描边、旋转、裁切。
               「浮出」会把它搬进一个可移动的非模态大窗口（见 GeometryPanelWindow）。 -->
          <views:GeometryPanel Grid.Row="7" x:Name="GeoPanel"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 两个「操作浮层」窗口 =====
         视频画面是 Win32 子窗口（HwndHost），按 Windows 的规则，同一个窗口里的 WPF 内容
         永远画不到它上面（空气空间限制）。所以下面两件事都改用「贴在监视器上的独立顶层窗口」：

         ① ProgramOvPopup：显示文字/图片叠加层 —— 独立顶层窗口才能盖在视频之上；
            输出吃的是内存合成帧（叠加层由合成器一起画进去），这个浮层只负责让你在屏幕上看到。
         ② PreviewOpPopup：接管预览框的拖动/缩放 —— 不再依赖全局鼠标钩子
            （钩子在部分环境下会失效，表现为"按住左键拖不动"），改用标准 WPF 鼠标事件。 -->
    <Popup x:Name="ProgramOvPopup" Grid.RowSpan="3"
           PlacementTarget="{Binding ElementName=LayersCanvas}"
           Placement="Relative" HorizontalOffset="0" VerticalOffset="0"
           AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None">
      <Grid x:Name="ProgramOvRoot" Background="Transparent" IsHitTestVisible="False">
        <!-- 图层描边（精调面板设的粗细/圆角/颜色）。单独一层、压在叠加层文字之下：
             视频是 Win32 子窗口，只有这个独立顶层窗口里的元素才能盖在画面之上。 -->
        <Canvas x:Name="LayerBorderCanvas"/>
        <Canvas x:Name="OverlayCanvas"/>
        <!-- FTB 淡黑：放在叠加层之上，点击 FTB 时整屏（视频 + 叠加层）一起淡黑。
             以前对 LayersCanvas 做透明度动画是无效的 —— HwndHost 视频子窗口不受影响。 -->
        <Rectangle x:Name="FtbRect" Fill="Black" Opacity="0"/>
      </Grid>
    </Popup>

    <Popup x:Name="PreviewOpPopup" Grid.RowSpan="3"
           PlacementTarget="{Binding ElementName=PreviewCanvas}"
           Placement="Relative" HorizontalOffset="0" VerticalOffset="0"
           AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None">
      <!-- Background 用 alpha=1 的近乎全透明色：分层窗口下 alpha=0 的区域会"点不到"，
           1/255 的黑色肉眼完全看不出，但能正常接收鼠标 -->
      <Grid x:Name="PreviewOpRoot" Background="#01000000" Cursor="SizeAll"
            ToolTip="点中某一格可单独选中它；按住左键拖动位置，滚轮或拖右下角黄块缩放"
            MouseLeftButtonDown="PreviewOpRoot_MouseLeftButtonDown"
            MouseMove="PreviewOpRoot_MouseMove"
            MouseLeftButtonUp="PreviewOpRoot_MouseLeftButtonUp"
            MouseWheel="PreviewOpRoot_MouseWheel"
            LostMouseCapture="PreviewOpRoot_LostMouseCapture">
        <!-- 每个预览槽在这里有一个金色选中框（动态创建，见 RefreshPreviewHitDecor）：
             用来"看得出当前在操作哪一路"。
             Canvas 本身 Background=null（不参与命中测试），所以不挡下面的拖动/缩放；
             命中哪一路由代码按几何矩形判定（比挂一堆透明元素更稳，不会跟元素生命周期打架）。
             缩放柄也放进来 —— 放在 Grid 里就永远只能钉在预览框右下角，
             多路时得跟着「当前选中的那一路」跑，只有 Canvas 能给子元素定位。 -->
        <Canvas x:Name="PreviewOpHitCanvas">
          <!-- 三分法网格（老板 2026-10-18）：选中任意一路时显示，画在整个取景框上。
               为什么要浮层里画：视频是 Win32 子窗口，画在画布上的线会被它整个盖住。 -->
          <Line x:Name="GridV1" Stroke="#5533C6F5" StrokeThickness="1" StrokeDashArray="3 4"
                Visibility="Collapsed" IsHitTestVisible="False"/>
          <Line x:Name="GridV2" Stroke="#5533C6F5" StrokeThickness="1" StrokeDashArray="3 4"
                Visibility="Collapsed" IsHitTestVisible="False"/>
          <Line x:Name="GridH1" Stroke="#5533C6F5" StrokeThickness="1" StrokeDashArray="3 4"
                Visibility="Collapsed" IsHitTestVisible="False"/>
          <Line x:Name="GridH2" Stroke="#5533C6F5" StrokeThickness="1" StrokeDashArray="3 4"
                Visibility="Collapsed" IsHitTestVisible="False"/>

          <!-- 智能吸附参考线：拖动时边缘/中心离对齐线 6px 以内才出现（青色实线）。
               只有 V / H 各一条 —— 一次拖动最多吸一条竖线 + 一条横线，够用且不添乱。 -->
          <Line x:Name="SnapV" Stroke="#FF00E5FF" StrokeThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False"/>
          <Line x:Name="SnapH" Stroke="#FF00E5FF" StrokeThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False"/>

          <Border x:Name="PreviewResizeGrip" Width="14" Height="14" Panel.ZIndex="900"
                  Background="{DynamicResource Brush.Gold}" CornerRadius="2" Cursor="SizeNWSE"
                  Visibility="Collapsed"/>
        </Canvas>
      </Grid>
    </Popup>

    <!-- ===== 性能不足横幅（老板 2026-10-20：经常性 CPU 报警就直说「建议升级您的电脑」） =====
         为什么是主窗内的横幅、不是弹窗：
           · 弹窗会挡播出画面（铁律：导播中绝不弹模态框）；
           · 独立顶层窗会盖到别的程序上，而这条提示往往和老板正在干的事无关；
           · 横幅贴在状态栏正上方，看得见、不抢焦点、不越出主窗，程序一关就走。
         默认折叠，只在 PerfAdvice 判定「长期不足」时展开 15 秒。 -->
    <!-- 注：Border 在 WPF 里不创建 AutomationPeer，挂 AutomationProperties 也不会出现在 UIA 树里。
         离屏验证时靠「PerfBannerTitle 文本是否为空」判断横幅状态（CollapsePerfBanner 会清空文本）。 -->
    <Border x:Name="PerfBanner" Grid.Row="1" VerticalAlignment="Bottom" Visibility="Collapsed"
            Panel.ZIndex="900" Background="{DynamicResource Brush.Bg.Raised}"
            BorderBrush="{DynamicResource Brush.Warn}" BorderThickness="4,1,1,1" Padding="14,10,12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="⚠" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                   Foreground="{DynamicResource Brush.Warn}"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="PerfBannerTitle" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text}"/>
          <TextBlock x:Name="PerfBannerSub" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"
                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button x:Name="BtnPerfDetail" Content="查看详情" Style="{StaticResource VmButton}"
                  Height="28" MinHeight="0" Padding="14,0" Margin="0,0,8,0"
                  Click="PerfBannerDetail_Click"
                  ToolTip="看清楚是哪一项不够、现在占用多少、这台电脑什么配置、能怎么救"/>
          <Button x:Name="BtnPerfDismiss" Content="知道了" Style="{StaticResource VmButton}"
                  Height="28" MinHeight="0" Padding="14,0"
                  Click="PerfBannerDismiss_Click"
                  ToolTip="收起这条提示（这次运行不再弹；重启程序后如仍不足会再提醒）"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 分辨率变更浮动条（老板 2026-10-20 22:55：按钮要单独浮出来） =====
         为什么从菜单里浮到界面上：
           「保存文件立即重启」是要马上点的动作，藏在「视图 → 输出分辨率」两层菜单里，
           选完还得再展开一遍菜单才能点 —— 步骤多、容易忘。
         为什么是主窗内浮层、不是弹窗/顶层窗：
           导播中绝不弹模态框（铁律 14）。这条只在选了跟当前不同的分辨率后出现，
           点「稍后」就收起，菜单里同样留了一份入口（收起来也找得到）。
         位置（老板 2026-10-20 23:12：「为什么按钮要在最下面 应该在原菜单附近」）：
           紧贴菜单栏下沿、左缘对齐「视图」菜单项 —— 就是刚收起的那个下拉菜单原来的位置。
           选完菜单一收、提示条落在原地，视线不用从顶部跳到屏幕最底下。
           X 由 PositionResBar() 在显示时按 MiViewMenu 的实际位置算（窗口尺寸变化会重算），
           这里的 Margin 只是兜底初值。 -->
    <Border x:Name="ResRestartBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"
            Visibility="Collapsed" Panel.ZIndex="950" Margin="8,6,0,0"
            Background="{DynamicResource Brush.Bg.Raised}"
            BorderBrush="{DynamicResource Brush.Warn}" BorderThickness="2"
            CornerRadius="6" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ResRestartText" Grid.Column="0" VerticalAlignment="Center"
                   MaxWidth="440" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                   Foreground="{DynamicResource Brush.Text}"/>

        <Button x:Name="BtnResRestart" Grid.Column="1" Content="保存文件立即重启"
                Height="32" MinHeight="0" Padding="18,0" Margin="16,0,0,0"
                FontWeight="Bold" FontSize="13"
                Background="{DynamicResource Brush.Warn}"
                Foreground="{DynamicResource Brush.Bg.Base}"
                ToolTip="先保存当前工程，再自动重启 Cutlance，按新尺寸重新打开"
                Click="ResRestartBar_Click"/>

        <Button x:Name="BtnResLater" Grid.Column="2" Content="稍后"
                Height="32" MinHeight="0" Padding="12,0" Margin="8,0,0,0"
                Style="{StaticResource VmButton}"
                ToolTip="先收起这条提示（选择仍记着），随时可从「视图 → 输出分辨率 → 保存文件立即重启」再点"
                Click="ResRestartLater_Click"/>
      </Grid>
    </Border>

    <!-- ===== 状态栏（含推流/录制指示灯） ===== -->
    <StatusBar Grid.Row="2" Background="{DynamicResource Brush.Bg.StatusBar}">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="OnAirDot" Width="9" Height="9" Fill="{DynamicResource Brush.Pgm}" Margin="6,0,4,0"/>
          <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource Brush.Text}" FontSize="12" Margin="4,0"/>
        </StackPanel>
      </StatusBarItem>
      <!-- 模块B：倒计时（状态栏常驻显示 + 快捷开始/暂停） -->
      <StatusBarItem>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Clock}" Stroke="{DynamicResource Brush.Pvw}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountdownText" Text="--:--" Foreground="{DynamicResource Brush.Pvw}"
                     FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="BtnCdQuick" Width="26" Height="19" Padding="0" MinHeight="0"
                  Background="{DynamicResource Brush.Bg.Raised}" Foreground="{DynamicResource Brush.Text}" Click="BtnCdQuick_Click"
                  ToolTip="快速开始 / 暂停倒计时；时长与到点动作在「设置 → 倒计时 / 触发器」里配置">
            <Path Style="{StaticResource IconSolid}" Data="{StaticResource Icon.Play}" Width="10" Height="10"/>
          </Button>
        </StackPanel>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- 系统监控（CPU / 内存 / 显存）—— 老板 2026-10-17 要求。
               正常时是灰色小字；越线后对应数字变琥珀/红并加粗、SysDot 变色闪烁，
               同时右侧弹出告警文字。总量 / 显卡型号 / 阈值等明细全放 ToolTip，
               状态栏本体只占很窄一格，不会挤掉推流·录制指示。 -->
          <StackPanel x:Name="SysMonitorPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0">
            <StackPanel.ToolTip>
              <TextBlock x:Name="SysTipText" Text="系统资源监控"/>
            </StackPanel.ToolTip>
            <Ellipse x:Name="SysDot" Width="8" Height="8" Fill="{DynamicResource Brush.Ok}"
                     Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="CpuText" Text="CPU --" Foreground="{DynamicResource Brush.Text.Secondary}"
                       FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text=" · " Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="MemText" Text="内存 --" Foreground="{DynamicResource Brush.Text.Secondary}"
                       FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text=" · " Foreground="{DynamicResource Brush.Text.Disabled}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="GpuText" Text="显存 --" Foreground="{DynamicResource Brush.Text.Secondary}"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="SysAlertText" Text="" Visibility="Collapsed"
                     Foreground="{DynamicResource Brush.Pgm}" FontWeight="Bold" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Ellipse x:Name="StreamDot" Width="8" Height="8" Fill="{DynamicResource Brush.Text.Disabled}" Margin="4,0"/>
          <TextBlock x:Name="StreamLbl" Text="推流 关" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="3,0,10,0"/>
          <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{DynamicResource Brush.Text.Disabled}" Margin="4,0"/>
          <TextBlock x:Name="RecLbl" Text="录制 关" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="3,0,10,0"/>
          <TextBlock x:Name="StreamElapsed" Text="" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,10,0"/>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
