<Window x:Class="Cutlance.SubtitleStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕条样式" Height="792" Width="648"
        WindowStartupLocation="Manual" ResizeMode="CanResize"
        ShowInTaskbar="False" MinHeight="620" MinWidth="480"
        Style="{StaticResource AppWindow}">
  <!-- 老板 2026-10-19 21:42：
         「1 设定把 字幕条大小 以及所处位置 都是可以移动的
          3 字幕条文字颜色可以更换」
       大小 / 位置 / 颜色全在这里调，右边预览实时跟着变；
       2026-10-19 22:57「移动字幕条时同步在输出框里显示移动后效果」→
       **主窗的输出框也会同步跟着动**（拖的时候就能看到压上节目的真实效果）；
       点「应用」才重新生成所有字幕条（行多时要几秒），点「取消」主窗原样还原。 -->

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>      <!-- 预览 + 参数（可滚动） -->
      <RowDefinition Height="Auto"/>   <!-- 底部按钮（永远固定在窗口底） -->
    </Grid.RowDefinitions>

    <!-- ⚠ 内容放进 ScrollViewer：本机 1600 高够用，但 1366×768 的笔记本
         （@125% 只有 614 DIP 高）放不下这么多行，不加滚动就把「应用」按钮挤出屏幕了。 -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <StackPanel>

    <!-- ===== 预览（16:9，底下那层深色是模拟节目画面，只为看清位置）===== -->
    <Border Background="{DynamicResource Brush.Bg.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="6" Padding="4">
      <Border x:Name="PreviewHost" Height="315" Background="#102030" CornerRadius="4"
              ClipToBounds="True">
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
      </Border>
    </Border>

    <!-- ===== 表格内容对照（老板 2026-10-19 22:15：
             「应该出现表格前 现在 后 表格里的文字 防止上字幕出现错误」）
         把上一条 / 上屏中 / 下一条的字一起摆出来，眼过一遍再翻页；
         点某一条只是**换预览**，绝不会真的换掉正在上屏的那条。 -->
    <Border x:Name="RowPeekPanel" Margin="0,10,0,0" Padding="12,10" Visibility="Collapsed"
            Background="{DynamicResource Brush.Bg.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <StackPanel>
        <TextBlock Text="表格内容对照（上屏前先核对）" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4"/>
        <TextBlock Text="点任意一条只会换上面的预览，不会真的换掉正在上屏的那条。"
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                   Foreground="{DynamicResource Brush.Text.Muted}"/>

        <Button x:Name="BtnRowPrev" Height="46" Margin="0,2" Click="BtnRowPrev_Click"
                ToolTip="把上一条的字放进预览里看效果（不上屏）">
          <TextBlock x:Name="TxtPrev" TextWrapping="Wrap" MaxWidth="470"
                     TextTrimming="CharacterEllipsis" LineHeight="17"/>
        </Button>
        <Button x:Name="BtnRowNow" Height="46" Margin="0,2" Click="BtnRowNow_Click"
                ToolTip="把正在上屏的那条放进预览里看效果">
          <TextBlock x:Name="TxtNow" TextWrapping="Wrap" MaxWidth="470"
                     TextTrimming="CharacterEllipsis" LineHeight="17"/>
        </Button>
        <Button x:Name="BtnRowNext" Height="46" Margin="0,2" Click="BtnRowNext_Click"
                ToolTip="把下一条的字放进预览里看效果（不上屏）">
          <TextBlock x:Name="TxtNext" TextWrapping="Wrap" MaxWidth="470"
                     TextTrimming="CharacterEllipsis" LineHeight="17"/>
        </Button>

        <TextBlock x:Name="TxtRowPeek" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0"
                   Foreground="{DynamicResource Brush.Accent}"/>
      </StackPanel>
    </Border>

    <!-- ===== 大小 / 位置 ===== -->
    <Border Margin="0,10,0,0" Padding="12,10"
            Background="{DynamicResource Brush.Bg.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <StackPanel>
        <TextBlock Text="大小 / 位置" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="主字幕字号" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldMainSize" Grid.Column="1" Minimum="30" Maximum="140"
                  TickFrequency="1" IsSnapToTickEnabled="True" Value="68"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValMainSize" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="68"/>
        </Grid>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="副字幕字号" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldSubSize" Grid.Column="1" Minimum="16" Maximum="100"
                  TickFrequency="1" IsSnapToTickEnabled="True" Value="40"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValSubSize" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="40"/>
        </Grid>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="条子宽度" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldBarWidth" Grid.Column="1" Minimum="500" Maximum="1920"
                  TickFrequency="10" IsSnapToTickEnabled="True" Value="1280"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValBarWidth" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="1280"/>
        </Grid>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="距画面底部" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldBottom" Grid.Column="1" Minimum="0" Maximum="600"
                  TickFrequency="5" IsSnapToTickEnabled="True" Value="110"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValBottom" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="110"/>
        </Grid>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="左右偏移" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldOffsetX" Grid.Column="1" Minimum="-600" Maximum="600"
                  TickFrequency="5" IsSnapToTickEnabled="True" Value="0"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValOffsetX" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="0"/>
        </Grid>

        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="底色不透明" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Slider x:Name="SldAlpha" Grid.Column="1" Minimum="0" Maximum="255"
                  TickFrequency="5" IsSnapToTickEnabled="True" Value="204"
                  ValueChanged="AnyValueChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="ValAlpha" Grid.Column="2" VerticalAlignment="Center"
                     HorizontalAlignment="Right" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Text="204"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ===== 颜色 ===== -->
    <Border Margin="0,10,0,0" Padding="12,10"
            Background="{DynamicResource Brush.Bg.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <StackPanel>
        <TextBlock Text="文字颜色" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>

        <Grid Margin="0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="主字幕（第 1 列）" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Border x:Name="SwMain" Grid.Column="1" Width="36" Height="22" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#55FFFFFF" Background="#FFFFFFFF"/>
          <TextBox x:Name="TxtMainColor" Grid.Column="2" Margin="8,0,0,0" Height="24"
                   VerticalContentAlignment="Center" FontSize="12" Text="#FFFFFFFF"
                   TextChanged="ColorTextChanged"/>
          <Button Grid.Column="3" Content="选色" Width="52" Height="24" Margin="8,0,0,0"
                  HorizontalAlignment="Left" Click="PickMainColor"/>
        </Grid>

        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="副字幕（第 2 列）" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Border x:Name="SwSub" Grid.Column="1" Width="36" Height="22" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#55FFFFFF" Background="#FFDAE2EC"/>
          <TextBox x:Name="TxtSubColor" Grid.Column="2" Margin="8,0,0,0" Height="24"
                   VerticalContentAlignment="Center" FontSize="12" Text="#FFDAE2EC"
                   TextChanged="ColorTextChanged"/>
          <Button Grid.Column="3" Content="选色" Width="52" Height="24" Margin="8,0,0,0"
                  HorizontalAlignment="Left" Click="PickSubColor"/>
        </Grid>

        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="第三行（第 3 列起）" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Border x:Name="SwExtra" Grid.Column="1" Width="36" Height="22" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#55FFFFFF" Background="#FFB9C4D0"/>
          <TextBox x:Name="TxtExtraColor" Grid.Column="2" Margin="8,0,0,0" Height="24"
                   VerticalContentAlignment="Center" FontSize="12" Text="#FFB9C4D0"
                   TextChanged="ColorTextChanged"/>
          <Button Grid.Column="3" Content="选色" Width="52" Height="24" Margin="8,0,0,0"
                  HorizontalAlignment="Left" Click="PickExtraColor"/>
        </Grid>

        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="左侧竖条" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Border x:Name="SwAccent" Grid.Column="1" Width="36" Height="22" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#55FFFFFF" Background="#FF6EC7E8"/>
          <TextBox x:Name="TxtAccentColor" Grid.Column="2" Margin="8,0,0,0" Height="24"
                   VerticalContentAlignment="Center" FontSize="12" Text="#FF6EC7E8"
                   TextChanged="ColorTextChanged"/>
          <Button Grid.Column="3" Content="选色" Width="52" Height="24" Margin="8,0,0,0"
                  HorizontalAlignment="Left" Click="PickAccentColor"/>
        </Grid>

        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="条子底色" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
          <Border x:Name="SwBack" Grid.Column="1" Width="36" Height="22" CornerRadius="3"
                  BorderThickness="1" BorderBrush="#55FFFFFF" Background="#FF10141A"/>
          <TextBox x:Name="TxtBackColor" Grid.Column="2" Margin="8,0,0,0" Height="24"
                   VerticalContentAlignment="Center" FontSize="12" Text="#FF10141A"
                   TextChanged="ColorTextChanged"/>
          <Button Grid.Column="3" Content="选色" Width="52" Height="24" Margin="8,0,0,0"
                  HorizontalAlignment="Left" Click="PickBackColor"/>
        </Grid>

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   Text="颜色可以手输十六进制（如 #FFFFD54F），也可以点「选色」挑。底色不透明度拉到底就是全透明、只剩字。"/>
      </StackPanel>
    </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ===== 底部按钮 ===== -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnReset" Content="恢复默认" Style="{StaticResource BtnGhost}"
              Width="96" Height="32" Margin="0,0,10,0" Click="BtnReset_Click"/>
      <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BtnGhost}"
              Width="88" Height="32" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
      <Button x:Name="BtnOk" Content="应用" Style="{StaticResource BtnPrimary}"
              Width="110" Height="32" IsDefault="True" Click="BtnOk_Click"/>
    </StackPanel>

    <!-- 共用色板：点「选色」时在按钮下方弹出 -->
    <Popup x:Name="PalettePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
      <Border Background="{DynamicResource Brush.Bg.Panel}"
              BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
              CornerRadius="4" Padding="6">
        <WrapPanel x:Name="PalettePanel" Width="216"/>
      </Border>
    </Popup>
  </Grid>
</Window>
