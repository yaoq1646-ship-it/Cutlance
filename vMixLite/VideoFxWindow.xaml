<Window x:Class="Cutlance.VideoFxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画面效果 · 调色 / 美颜 / 美体（NVIDIA 显卡）" Height="740" Width="960" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <Style x:Key="FxBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Raised}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bg.StatusBar}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <!-- 数值（滑块右侧读数 / 可编辑数值框 / 测算输入框）：统一用主题强调蓝，替代旧红字 -->
    <Style x:Key="Val" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <!-- 数值框：滑块右侧的数字，可直接点击输入（回车 / 点别处生效，Esc 取消）-->
    <Style x:Key="ValBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="54"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="可直接输入数值：回车或点别处生效，Esc 取消；超出范围自动取边界值"/>
    </Style>
    <!-- 数值范围提示（最小值~最大值）：问题1 要求所有数值都标明上下限 -->
    <Style x:Key="Rng" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <!-- 测算输入框 -->
    <Style x:Key="Inp" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 下拉选择项文字红色（与全站下拉一致）-->
    <!-- 测算结果行 -->
    <Style x:Key="Res" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>   <!-- 底部固定操作条（不随内容滚动） -->
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="390"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左：参数区 -->
    <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 以下三组需要 NVENC 才生效，非 NVENC 时整体禁用 -->
        <StackPanel x:Name="FxPanel">
          <GroupBox Header="调色" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" Padding="6">
            <StackPanel>
              <TextBlock Text="亮度" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdBright" Minimum="-30" Maximum="30" Value="0"
                         ValueChanged="Slider_Changed" Tag="bright"/><TextBox x:Name="TxBright" Tag="bright"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="-30~30" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 -30 ～ 最大 30"/></DockPanel>
              <TextBlock Text="对比度 %" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdContrast" Minimum="50" Maximum="200" Value="100"
                         ValueChanged="Slider_Changed" Tag="contrast"/><TextBox x:Name="TxContrast" Tag="contrast"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="50~200" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 50 ～ 最大 200"/></DockPanel>
              <TextBlock Text="饱和度 %" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdSat" Minimum="0" Maximum="250" Value="100"
                         ValueChanged="Slider_Changed" Tag="sat"/><TextBox x:Name="TxSat" Tag="sat"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~250" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 250"/></DockPanel>
              <TextBlock Text="伽马" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdGamma" Minimum="50" Maximum="250" Value="100"
                         ValueChanged="Slider_Changed" Tag="gamma"/><TextBox x:Name="TxGamma" Tag="gamma"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="50~250" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 50 ～ 最大 250"/></DockPanel>
              <TextBlock Text="色温（左冷 / 右暖）" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdTemp" Minimum="-100" Maximum="100" Value="0"
                         ValueChanged="Slider_Changed" Tag="temp"/><TextBox x:Name="TxTemp" Tag="temp"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="-100~100" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 -100 ～ 最大 100"/></DockPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="美颜" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" Padding="6" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="美白（提亮肤色）" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdWhiten" Minimum="0" Maximum="10" Value="0"
                         ValueChanged="Slider_Changed" Tag="whiten"/><TextBox x:Name="TxWhiten" Tag="whiten"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>
              <TextBlock Text="磨皮（柔化皮肤细节）" Style="{StaticResource Lbl}"/>
              <DockPanel><Slider x:Name="SdSmooth" Minimum="0" Maximum="10" Value="0"
                         ValueChanged="Slider_Changed" Tag="smooth"/><TextBox x:Name="TxSmooth" Tag="smooth"
                         Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                         GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="美体（分段局部形变）" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" Padding="6"
                    Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="形变方式" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="CbShape" Background="{DynamicResource Brush.Bg.Surface}"
                        SelectionChanged="ShapeMode_Changed">
                <ComboBoxItem Content="分段局部形变（腰段 / 腿段独立，推荐）" IsSelected="True"/>
                <ComboBoxItem Content="整幅近似形变（旧方式）"/>
              </ComboBox>

              <!-- ===== 分段局部：腰段横向压窄 + 腿段纵向拉长，头胸不动（坐标映射 remap）===== -->
              <StackPanel x:Name="SegPanel" Margin="0,4,0,0">
                <!-- 腰/臀线预设（老板 2026-10-22：竖屏单独一套默认值）
                     横屏 46/62 是原出厂值；竖屏 52/66 出自实测（p17 三组对比图）。 -->
                <Border Background="{DynamicResource Brush.Bg.Surface}" CornerRadius="3"
                        Padding="8,6" Margin="0,2,0,6">
                  <DockPanel>
                    <Button x:Name="BtnLinePreset" DockPanel.Dock="Right" Style="{StaticResource FxBtn}"
                            Content="套用竖屏默认" Margin="0,0,0,0" Padding="8,3"
                            Click="BtnLinePreset_Click"
                            ToolTip="一键把腰线/臀线设成当前输出方向的默认值。&#x0a;竖屏 52 / 66，横屏 46 / 62。&#x0a;你自己拖过的值不会被自动覆盖。"/>
                    <TextBlock x:Name="TbLinePreset" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"
                               Margin="0,0,8,0" Text="腰臀线预设：横屏 46 / 62"/>
                  </DockPanel>
                </Border>

                <TextBlock Text="① 腰线位置（画面高度 %，从顶部算）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdWaistY" Minimum="25" Maximum="70" Value="46"
                           ValueChanged="Slider_Changed" Tag="waisty"/><TextBox x:Name="TxWaistY" Tag="waisty"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="25~70" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 25 ～ 最大 70"/></DockPanel>

                <TextBlock Text="② 臀线位置（画面高度 %）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdHipY" Minimum="35" Maximum="85" Value="62"
                           ValueChanged="Slider_Changed" Tag="hipy"/><TextBox x:Name="TxHipY" Tag="hipy"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="35~85" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 35 ～ 最大 85"/></DockPanel>

                <TextBlock Text="③ 腰段收缩（腰线→臀线 横向压窄，真改腰臀比观感）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdSlimSeg" Minimum="0" Maximum="10" Value="0"
                           ValueChanged="Slider_Changed" Tag="slimseg"/><TextBox x:Name="TxSlimSeg" Tag="slimseg"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>

                <TextBlock Text="④ 腿段拉伸（臀线以下 纵向拉长，真改腿身比观感）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdLegSeg" Minimum="0" Maximum="10" Value="0"
                           ValueChanged="Slider_Changed" Tag="legseg"/><TextBox x:Name="TxLegSeg" Tag="legseg"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>

                <TextBlock Text="⑤ 作用中心（画面宽度 %，对准人物站立位置）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdCenterX" Minimum="10" Maximum="90" Value="50"
                           ValueChanged="Slider_Changed" Tag="centerx"/><TextBox x:Name="TxCenterX" Tag="centerx"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="10~90" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 10 ～ 最大 90"/></DockPanel>

                <TextBlock Text="⑥ 作用宽度（画面宽度 %，越大影响范围越宽、边缘越不易看出）"
                           Style="{StaticResource Lbl}" TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdWarpW" Minimum="20" Maximum="100" Value="70"
                           ValueChanged="Slider_Changed" Tag="warpw"/><TextBox x:Name="TxWarpW" Tag="warpw"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="20~100" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 20 ～ 最大 100"/></DockPanel>

                <TextBlock Text="说明：腰段整段横向压窄、腿段自臀线向下拉长，头部与胸部保持原样（曲线过渡、无接缝）。腿段拉长会把画面下沿以外部分裁掉（脚可能出画）；作用宽度外的人物/背景不受影响，可用「作用中心」对准人物。"
                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>

              <!-- ===== 整幅近似（旧方式：全画面桶形 + 垂直拉伸）===== -->
              <StackPanel x:Name="GlobalPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="瘦身（镜头桶形；越大人越瘦，背景随动）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdSlim" Minimum="0" Maximum="10" Value="0"
                           ValueChanged="Slider_Changed" Tag="slim"/><TextBox x:Name="TxSlim" Tag="slim"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>
                <TextBlock Text="拉长（垂直放大后裁上下，人显高挑）" Style="{StaticResource Lbl}"
                           TextWrapping="Wrap"/>
                <DockPanel><Slider x:Name="SdStretch" Minimum="0" Maximum="10" Value="0"
                           ValueChanged="Slider_Changed" Tag="stretch"/><TextBox x:Name="TxStretch" Tag="stretch"
                           Style="{StaticResource ValBox}" KeyDown="ValBox_KeyDown"
                           GotKeyboardFocus="ValBox_GotKeyboardFocus" LostKeyboardFocus="ValBox_LostKeyboardFocus"/><TextBlock Text="0~10" Style="{StaticResource Rng}" ToolTip="可输入范围：最小 0 ～ 最大 10"/></DockPanel>
                <TextBlock Text="说明：整幅画面一起形变（含头、背景），只能整体缩放/拉伸，不能只改某一部位。"
                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <!-- ===== 美学比例测算（纯计算，不依赖 NVENC）===== -->
        <GroupBox Header="美学比例测算（改任一项，建议值实时更新）" Foreground="{DynamicResource Brush.Text}"
                  BorderBrush="{DynamicResource Brush.Border}" Padding="6" Margin="0,10,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4,6,0">
                <TextBlock Text="身高" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="BxHeight" Width="52" Margin="4,0,0,0" Style="{StaticResource Inp}"
                         TextChanged="BodyInput_Changed"/><TextBlock Text="cm 100~250" Style="{StaticResource Rng}" ToolTip="单位：厘米(cm)；常用范围 100 ～ 250"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="肚脐高" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="BxNavel" Width="52" Margin="4,0,0,0" Style="{StaticResource Inp}"
                         TextChanged="BodyInput_Changed"/><TextBlock Text="cm 60~160" Style="{StaticResource Rng}" ToolTip="单位：厘米(cm)；常用范围 60 ～ 160"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,6,0">
                <TextBlock Text="坐高" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="BxSit" Width="52" Margin="4,0,0,0" Style="{StaticResource Inp}"
                         TextChanged="BodyInput_Changed"/><TextBlock Text="cm 40~130" Style="{StaticResource Rng}" ToolTip="单位：厘米(cm)；常用范围 40 ～ 130"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="腰围" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="BxWaist" Width="52" Margin="4,0,0,0" Style="{StaticResource Inp}"
                         TextChanged="BodyInput_Changed"/><TextBlock Text="cm 40~200" Style="{StaticResource Rng}" ToolTip="单位：厘米(cm)；常用范围 40 ～ 200"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,6,6,0">
                <TextBlock Text="臀围" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="BxHip" Width="52" Margin="4,0,0,0" Style="{StaticResource Inp}"
                         TextChanged="BodyInput_Changed"/><TextBlock Text="cm 50~200" Style="{StaticResource Rng}" ToolTip="单位：厘米(cm)；常用范围 50 ～ 200"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="性别" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbSex" Width="72" Margin="4,0,0,0" Background="{DynamicResource Brush.Bg.Surface}"
                          SelectionChanged="BodySex_Changed">
                  <ComboBoxItem Content="女性" IsSelected="True"/>
                  <ComboBoxItem Content="男性"/>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                          Margin="0,6,0,0">
                <TextBlock Text="腿身比口径" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbLegStd" Width="176" Margin="4,0,0,0" Background="{DynamicResource Brush.Bg.Surface}"
                          SelectionChanged="BodyLegStd_Changed">
                  <ComboBoxItem Content="腿长占身高 54%~57%" IsSelected="True"/>
                  <ComboBoxItem Content="马氏指数 74.4~94.4"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Brush.Bg.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6"
                    Margin="0,8,0,0">
              <StackPanel>
                <TextBlock x:Name="TxGolden" Style="{StaticResource Res}"/>
                <TextBlock x:Name="TxWhr" Style="{StaticResource Res}"/>
                <TextBlock x:Name="TxLeg" Style="{StaticResource Res}"/>
                <TextBlock x:Name="TxManouvrier" Style="{StaticResource Res}"/>
              </StackPanel>
            </Border>

            <Button x:Name="ApplySuggestBtn" Style="{StaticResource FxBtn}" Content="应用建议值到美体滑块"
                    Margin="0,8,0,0" HorizontalAlignment="Left" Click="ApplySuggestBtn_Click"/>
            <TextBlock x:Name="SuggestHint" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <!-- 右：预览区（与左列各自可滚：小逻辑屏下窗口高度被 WindowFit 收敛后，预览图也要能滚到） -->
    <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,0,0,0">
      <TextBlock x:Name="StateHint" Text="" Foreground="{DynamicResource Brush.Warn}" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Text="原图（未处理）" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,10,0,4"/>
      <Border Background="{DynamicResource Brush.Bg.StatusBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Height="205">
        <Image x:Name="ImgOrig" Stretch="Uniform"/>
      </Border>
      <TextBlock Text="效果图（当前参数）" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,10,0,4"/>
      <Border Background="{DynamicResource Brush.Bg.StatusBar}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Height="205">
        <Image x:Name="ImgFx" Stretch="Uniform"/>
      </Border>
      <TextBlock x:Name="PreviewHint" Text="打开本窗口会自动抓一次对比图；之后改完参数可随时点「抓帧对比预览」重抓（约 1–3 秒）。"
                 Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="提示：画面效果作用于「播出框」整幅画面，因此会同时进入推流与录制；参数改动在重新开始输出后生效。"
                 Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    </ScrollViewer>

    <!-- 底部固定操作条：⚠ 这三个按钮原在左列 ScrollViewer 最底部，被长长的参数列表挤出可视区，
         老板反馈「打开看不到原图/效果图」根本原因是按钮点不到 → 固定到窗口底部，永不随内容滚走。 -->
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="ResetBtn" Style="{StaticResource FxBtn}" Content="恢复默认" Click="ResetBtn_Click"
              ToolTip="把调色 / 美颜 / 美体所有参数恢复到出厂默认"/>
      <Button x:Name="PreviewBtn" Style="{StaticResource FxBtn}" Content="抓帧对比预览" Click="PreviewBtn_Click"
              ToolTip="抓取主窗「播出框」当前画面，同一帧分别按「零效果」与「当前参数」处理，左右对比（约 1–3 秒）"/>
      <Button x:Name="CloseBtn" Style="{StaticResource FxBtn}" Content="关闭" Width="70" Click="CloseBtn_Click"/>
    </StackPanel>
  </Grid>
</Window>
