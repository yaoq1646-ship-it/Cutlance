<Window x:Class="Cutlance.FullscreenOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cutlance 输出" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Background="Black"
        Topmost="True" AllowsTransparency="False">
  <!-- ⚠ 2026-10-24：这里**故意不再套 Style="{StaticResource AppWindow}"**。
       全屏窗现在跑在独立 STA 线程上（Views.FullscreenOutputHost），而主题样式里有 Icon setter，
       那个 ImageSource 是主线程创建的 —— 新线程 Window.Show() → UpdateIcon() 去读它的 Frames，
       直接抛「调用线程无法访问此对象」（实测 23:20 起窗失败，紧跟着就是系统硬错误框）。
       全屏窗本来就无边框纯黑，不需要主题，去掉样式是干净解法（不是绕）。 -->
  <!-- 画面来源是合成器的 WriteableBitmap（跟推流/录制同一份像素）。
       以前这里是 VideoView + screen:// 抓播出框 —— 抓屏版本一旦被遮挡就黑屏，
       C 方案直接把成品帧贴上来，窗口怎么摆都不影响画面。 -->
  <Grid Background="Black">
    <!-- 右键刷新（老板 2026-10-21 第 3 条）：副屏画面卡住/花屏/热插拔显示器后，
         在副屏上右键点一下即可重新贴图 + 重新定位（不是模态框，导播中也能用）。 -->
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="刷新画面（卡住 / 花屏时用）" Click="MenuRefresh_Click"/>
      </ContextMenu>
    </Grid.ContextMenu>
    <Image x:Name="Host" Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality"/>
  </Grid>
</Window>
