<Window x:Class="Cutlance.NetworkStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络流输入 — RTSP / SRT / RTMP / HTTP" Height="860" Width="1020" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 下拉项：浅色是 WPF 默认模板的系统色，必须自绘，否则深色界面上是刺眼的白底黑字 -->
    <!-- 下拉框本体：WPF 默认模板用固定系统色，Background 设了也不生效 → 整段自绘 -->
    <!-- 输入框：深色主题下 WPF 默认模板的边框/背景也偏亮，统一自绘 -->
    <!-- 按钮：WPF 默认模板会退化成系统浅色底（白底 + 我设的浅色字 = 几乎看不见）。
         实测踩过：面板上「测试第一行地址」「添加为输入」都成了白底浅字，不放大根本读不出。
         这里自绘：背景一律取 Button.Background，各按钮在 XAML 里给色即可。 -->
  </Window.Resources>

  <!-- 内容整体可滚：小逻辑屏（如 1080p@150%）下窗口高度会被 WindowFit 收敛到屏幕可用区，
       这里保证收敛后「收藏列表 + 底部按钮」仍能滚到。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <!-- 原来是 *（吃剩余空间）。套进 ScrollViewer 后星号行等价于 Auto，
           收藏列表改显式 130 高，高度可预期、整窗不会撑到屏幕外。 -->
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="① 网络流地址" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Warn}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                 Text="把地址粘进来（可一次粘多条，每行一条）。识别结果会实时更新 —— 先看清楚它认成了什么，再决定要不要添加。"/>
    </StackPanel>

    <!-- URL 输入 -->
    <TextBox Grid.Row="1" x:Name="TxtUrl" Height="76" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
             TextChanged="TxtUrl_TextChanged"
             ToolTip="支持 RTSP / SRT / RTMP / HTTP(HLS) / RIST / UDP。粘贴时可带引号与空格，程序会自动清洗"/>

    <!-- ② 识别结果 -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Info.Border}" BorderThickness="1" Background="{DynamicResource Brush.Info.Bg}"
            Margin="0,10,0,0" Padding="10,8">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="② 识别结果" Foreground="{DynamicResource Brush.Pvw}" FontWeight="Bold" FontSize="13"
                     VerticalAlignment="Center"/>
          <Ellipse x:Name="ProtoDot" Width="9" Height="9" Fill="{DynamicResource Brush.Text.Secondary}"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock x:Name="ProtoText" Text="等待输入…" Foreground="{DynamicResource Brush.Text}" FontSize="12"
                     FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="UrlDetail" Style="{StaticResource Hint}" Margin="0,6,0,0"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="粘贴地址后，这里会显示协议、主机端口、路径与是否带鉴权。"/>
        <TextBlock x:Name="UrlWarn" Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Foreground="{DynamicResource Brush.Warn}" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <!-- ③ 传输参数 -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Bg.Surface}" BorderThickness="1" Background="{DynamicResource Brush.Bg.Sunken}"
            Margin="0,10,0,0" Padding="10,8">
      <StackPanel>
        <TextBlock Text="③ 传输参数" Style="{StaticResource SectTitle}"/>

        <!-- 第一行：协议 + RTSP 承载 + 超时 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="协议" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="1" x:Name="CmbProtocol" SelectionChanged="Param_Changed"
                    ToolTip="默认「自动」按地址前缀判定。裸地址（不带 rtsp:// 之类）会认不出来，那时在这里手动指定"/>

          <TextBlock Grid.Column="3" Text="RTSP 承载" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="4" x:Name="CmbRtspTransport" SelectionChanged="Param_Changed"
                    ToolTip="RTSP 独有。UDP 承载在内网延迟最低；跨网段/丢包网络会花屏，改 TCP 更稳。默认交给 ffmpeg 协商"/>

          <TextBlock Grid.Column="6" Text="连接超时" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="7" x:Name="TxtTimeout" Text="5000" TextAlignment="Center"
                   TextChanged="Param_Changed"
                   ToolTip="毫秒。源不在线时，超时越短失败暴露越快、重连开始越早。默认 5000"/>
          <TextBlock Grid.Column="8" Text="ms" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <!-- 第二行：SRT 专属 -->
        <Grid x:Name="SrtRow" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="SRT 参数" Foreground="{DynamicResource Brush.Pvw}" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1" Text="latency" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="2" x:Name="TxtSrtLatency" Text="120" TextAlignment="Center"
                   TextChanged="Param_Changed"
                   ToolTip="毫秒。SRT 的重传缓冲窗口：太小则丢包来不及重传（花屏），太大则延迟高。内网 120 够用，跨境/4G 回传常要 200~500"/>
          <TextBlock Grid.Column="3" Text="ms" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>

          <TextBlock Grid.Column="5" Text="模式" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="6" x:Name="CmbSrtMode" SelectionChanged="Param_Changed"
                    ToolTip="caller = 主动连对方（拉流常用）；listener = 本机监听等对方推"/>

          <TextBlock Grid.Column="8" Text="口令" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="9" x:Name="TxtSrtPassphrase" FontFamily="Consolas"
                   TextChanged="Param_Changed"
                   ToolTip="SRT 加密口令，留空 = 不加密。⚠ 会明文写进工程文件，别当密钥保险箱用"/>
        </Grid>

        <TextBlock x:Name="ParamHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   Text="参数按协议自动启用：SRT 口令/latency 只对 srt:// 生效，RTSP 承载只对 rtsp:// 生效。"/>
      </StackPanel>
    </Border>

    <!-- ④ 测试连接 -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Bg.Surface}" BorderThickness="1" Background="{DynamicResource Brush.Bg.Sunken}"
            Margin="0,10,0,0" Padding="10,8">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="④ 测试连接" Style="{StaticResource SectTitle}" Margin="0,0,0,0"
                     VerticalAlignment="Center"/>
          <Button x:Name="BtnProbe" Content="测试第一行地址" Width="130" Height="26"
                  Margin="14,0,0,0" Background="{DynamicResource Brush.Info.Border}" Foreground="{DynamicResource Brush.Info.Text}"
                  BorderThickness="0" Click="Probe_Click"
                  ToolTip="真连一次并读回分辨率/编码/码率。黑屏时先点它 —— 能把「地址错 / 源没开 / 被防火墙挡」区分开"/>
          <Button x:Name="BtnProbeAll" Content="测试全部" Width="90" Height="26"
                  Margin="8,0,0,0" Background="{DynamicResource Brush.Info.Border}" Foreground="{DynamicResource Brush.Info.Text}"
                  BorderThickness="0" Click="ProbeAll_Click"
                  ToolTip="逐条测试（串行，避免同时连同一个源把它挤掉）"/>
        </StackPanel>
        <TextBlock x:Name="ProbeText" Style="{StaticResource Hint}" Margin="0,7,0,0"
                   Foreground="{DynamicResource Brush.Text.Secondary}" Text="还没测试。点「测试第一行地址」真连一次看看。"/>
      </StackPanel>
    </Border>

    <!-- ⑤ 链路 / 延迟 / 去隔行 -->
    <Border Grid.Row="5" BorderBrush="{DynamicResource Brush.Bg.Surface}" BorderThickness="1" Background="{DynamicResource Brush.Bg.Sunken}"
            Margin="0,10,0,0" Padding="10,8">
      <StackPanel>
        <TextBlock Text="⑤ 接入方式" Style="{StaticResource SectTitle}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="链路" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="1" x:Name="CmbLink" SelectionChanged="Param_Changed"
                    ToolTip="默认 ffmpeg 预处理：全程只 1 路连接（网络源普遍限并发），且自带断流重连/状态灯/去隔行/低延迟"/>

          <TextBlock Grid.Column="3" Text="延迟档" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="4" x:Name="CmbLatency" SelectionChanged="Param_Changed"/>

          <TextBlock Grid.Column="6" Text="去隔行" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="7" x:Name="CmbDeint" SelectionChanged="Param_Changed"
                    ToolTip="1080i 等隔行流逐行播出会拉丝。默认「自动」，用测试连接的结果判断"/>
        </Grid>
        <TextBlock x:Name="LinkHint" Style="{StaticResource Hint}" Margin="0,7,0,0"
                   Text="推荐保持「ffmpeg 预处理」—— 网络源大多限制并发连接，直连时「预览 + 输出同看一路」会把源连爆。"/>
      </StackPanel>
    </Border>

    <!-- ⑥ 最近使用 / 收藏 -->
    <Border Grid.Row="6" BorderBrush="{DynamicResource Brush.Bg.Surface}" BorderThickness="1" Background="{DynamicResource Brush.Bg.Sunken}"
            Margin="0,10,0,0" Padding="10,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="⑥ 收藏 / 最近使用" Style="{StaticResource SectTitle}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <Button x:Name="BtnBookmark" Width="120" Height="24"
                  Background="{DynamicResource Brush.Bg.Raised}" Foreground="{DynamicResource Brush.Text}" BorderThickness="0" Click="Bookmark_Click">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconLine}" Data="{StaticResource Icon.Star}" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock Text="收藏当前地址" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="BtnDelBookmark" Content="删除选中" Width="80" Height="24"
                  Margin="8,0,0,0" Background="{DynamicResource Brush.Bg.Raised}" Foreground="{DynamicResource Brush.Text}"
                  BorderThickness="0" Click="DelBookmark_Click"/>
          <TextBlock x:Name="BookmarkHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                     Margin="12,0,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
        </StackPanel>
        <Border Height="130" BorderBrush="{DynamicResource Brush.Bg.Surface}" BorderThickness="1" Background="{DynamicResource Brush.Bg.Overlay}">
          <ListBox x:Name="BookmarkList" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource Brush.Text}" MouseDoubleClick="BookmarkList_MouseDoubleClick"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Brush.Text}" FontSize="12"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Url}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Border>

    <!-- 状态行 -->
    <TextBlock Grid.Row="7" x:Name="StatusLine" Style="{StaticResource Hint}"
               Margin="0,8,0,0" Text="就绪"/>

    <!-- 底部按钮 -->
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="添加为输入" x:Name="BtnAdd" Width="140" Height="32" Margin="0,0,10,0"
              Background="{DynamicResource Brush.Ok}" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold"
              IsEnabled="False" Click="Add_Click"/>
      <!-- 「关闭」= 退出/取消，不是主操作：改中性底色（原为琥珀色 Brush.Warn，
           比同排绿色的「添加为输入」还抢眼，层级反了；也与其它窗口的「关闭」不一致） -->
      <Button Content="关闭" Width="110" Height="32"
              Background="{DynamicResource Brush.Bg.Raised}" Foreground="{DynamicResource Brush.Text}"
              BorderBrush="{DynamicResource Brush.Bg.StatusBar}" BorderThickness="1" Click="Close_Click"/>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</Window>
