<Window x:Class="Cutlance.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改名" Height="188" Width="452"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        TextOptions.TextFormattingMode="Display">
  <!-- 老板 2026-10-20：「在左侧文件处鼠标右键 增加一个改名 把当前文件改成新名字」。
       只改**显示名**（左侧列表 / 预览标题 / 图层列表里那个名字），
       不动磁盘文件、不动设备名 —— 所以重开工程还在，删了原文件也不会因为改名而失效。 -->
  <Grid Margin="18,16,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TipText" Text="给这一路起个自己认得的名字"
               Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,8"/>

    <TextBox Grid.Row="1" x:Name="NameBox" Height="30" FontSize="14" Padding="6,0"
             VerticalContentAlignment="Center"
             Background="{DynamicResource Brush.Bg.Base}"
             Foreground="{DynamicResource Brush.Text}"
             BorderBrush="{DynamicResource Brush.Border}"
             KeyDown="NameBox_KeyDown"
             ToolTip="回车确定 / Esc 取消"/>

    <TextBlock Grid.Row="2" x:Name="ErrText" Text="" FontSize="11" Margin="0,6,0,0"
               Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BtnGhost}"
              Width="88" Height="32" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
      <Button x:Name="BtnOk" Content="确定" Style="{StaticResource BtnPrimary}"
              Width="96" Height="32" IsDefault="True" Click="BtnOk_Click"/>
    </StackPanel>
  </Grid>
</Window>
