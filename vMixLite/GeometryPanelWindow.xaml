<Window x:Class="Cutlance.GeometryPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Cutlance.Views"
        Title="精调面板" Height="430" Width="320"
        MinHeight="220" MinWidth="280"
        WindowStartupLocation="Manual" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
  <!-- 浮动版精调面板（老板 2026-10-18：「可拖出成浮动大窗」）。
       ⚠ 刻意**不用** Topmost、也不用 ShowDialog：
          · Topmost 会盖住播出画面（导播中是事故级）；
          · 模态窗口会把主窗口卡住，导播中同样不能用。
       它就是一个普通的、可以随便拖动的非模态窗口。 -->
  <views:GeometryPanel x:Name="Panel"/>
</Window>
