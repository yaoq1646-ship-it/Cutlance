                    SelectionChanged="Cmp_SelectionChanged"
                    ToolTip="这一路自己的压缩（管忽大忽小）；混完之后还有一道「输出总线压缩」"/>
        </Grid>
      </Border>

      <!-- 通道 8 -->
      <Border Style="{StaticResource ChBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="58"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
            <TextBlock Text="8" Foreground="{DynamicResource Brush.Pvw}" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ComboBox Grid.Column="1" x:Name="Dev8" Margin="6,0" Background="{DynamicResource Brush.Bg.Surface}"
                    SelectionChanged="Dev_SelectionChanged"/>
          <ComboBox Grid.Column="2" x:Name="Role8" Style="{StaticResource RoleBox}"
                    SelectionChanged="Role_SelectionChanged" Tag="8"/>
          <ToggleButton Grid.Column="3" x:Name="Pwr8" Style="{StaticResource PwrBtn}" Tag="8"
                        Checked="Pwr_Changed" Unchecked="Pwr_Changed"/>
          <Slider Grid.Column="4" x:Name="Vol8" Minimum="0" Maximum="200" Value="100"
                  Margin="4,0" ValueChanged="Vol_ValueChanged" Tag="8"/>
          <TextBlock Grid.Column="5" x:Name="Vol8Text" Text="0.0 dB" Style="{StaticResource Lbl}"/>
          <CheckBox Grid.Column="6" x:Name="Mut8" Content="静音" Foreground="{DynamicResource Brush.Text.Secondary}"
                    VerticalAlignment="Center" Checked="Mut_Changed" Unchecked="Mut_Changed" Tag="8"/>
          <ComboBox Grid.Column="7" x:Name="Cmp8" Height="22" FontSize="10" Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Bg.Surface}" Tag="8"
                    SelectionChanged="Cmp_SelectionChanged"
                    ToolTip="这一路自己的压缩（管忽大忽小）；混完之后还有一道「输出总线压缩」"/>
        </Grid>
      </Border>
      </StackPanel><!-- /ChList 采集通道 1–8 -->

      <!-- 输出总线：混音之后的最后一道闸（2026-10-23）
           八路各自调完音量再混，很容易超过 0 dB —— 一超过就是削顶破音，听众那边"噼"一下。
           压缩器把峰值压下去，最后再串一级 -1 dB 限幅兜底。 -->
      <Border Style="{StaticResource ChBox}" Margin="0,10,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="输出总线压缩" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <ComboBox x:Name="CompLevel" Width="96" Margin="10,0,0,0"
                      SelectionChanged="CompLevel_SelectionChanged"/>
            <TextBlock x:Name="CompDbText" Text="" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Lbl}"/>
          </StackPanel>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="阈值" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
            <Slider Grid.Column="1" x:Name="CompThreshold" Minimum="-40" Maximum="-3" Value="-18"
                    Margin="0,0,12,0" ValueChanged="Comp_ValueChanged"/>
            <TextBlock Grid.Column="2" Text="压缩比" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
            <Slider Grid.Column="3" x:Name="CompRatio" Minimum="1" Maximum="20" Value="3"
                    Margin="0,0,12,0" ValueChanged="Comp_ValueChanged"/>
            <TextBlock Grid.Column="4" Text="增益补偿" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
            <Slider Grid.Column="5" x:Name="CompMakeup" Minimum="0" Maximum="12" Value="2"
                    ValueChanged="Comp_ValueChanged"/>
          </Grid>

          <TextBlock x:Name="CompHint" Text="" Foreground="{DynamicResource Brush.Text.Muted}"
                     FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="TracksHint" Text="" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap"
                 Margin="0,2,0,0"/>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
