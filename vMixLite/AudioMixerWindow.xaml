          <ComboBox Grid.Column="7" x:Name="Cmp3" Height="22" FontSize="10" Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Bg.Surface}" Tag="3"
                    SelectionChanged="Cmp_SelectionChanged"
                    ToolTip="这一路自己的压缩（管忽大忽小）；混完之后还有一道「输出总线压缩」"/>
        </Grid>
