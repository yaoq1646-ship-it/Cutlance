        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="58"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
            <TextBlock Text="7" Foreground="{DynamicResource Brush.Gold}" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ComboBox Grid.Column="1" x:Name="Dev7" Margin="6,0" Background="{DynamicResource Brush.Bg.Surface}"
                    SelectionChanged="Dev_SelectionChanged"/>
          <ComboBox Grid.Column="2" x:Name="Role7" Style="{StaticResource RoleBox}"
                    SelectionChanged="Role_SelectionChanged" Tag="7"/>
          <ToggleButton Grid.Column="3" x:Name="Pwr7" Style="{StaticResource PwrBtn}" Tag="7"
                        Checked="Pwr_Changed" Unchecked="Pwr_Changed"/>
          <Slider Grid.Column="4" x:Name="Vol7" Minimum="0" Maximum="200" Value="100"
                  Margin="4,0" ValueChanged="Vol_ValueChanged" Tag="7"/>
          <TextBlock Grid.Column="5" x:Name="Vol7Text" Text="0.0 dB" Style="{StaticResource Lbl}"/>
          <CheckBox Grid.Column="6" x:Name="Mut7" Content="静音" Foreground="{DynamicResource Brush.Text.Secondary}"
                    VerticalAlignment="Center" Checked="Mut_Changed" Unchecked="Mut_Changed" Tag="7"/>
          <ComboBox Grid.Column="7" x:Name="Cmp7" Height="22" FontSize="10" Margin="6,0,0,0"
