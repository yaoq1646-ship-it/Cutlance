          <CheckBox Grid.Column="6" x:Name="Mut4" Content="静音" Foreground="{DynamicResource Brush.Text.Secondary}"
                    VerticalAlignment="Center" Checked="Mut_Changed" Unchecked="Mut_Changed" Tag="4"/>
          <ComboBox Grid.Column="7" x:Name="Cmp4" Height="22" FontSize="10" Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Bg.Surface}" Tag="4"
                    SelectionChanged="Cmp_SelectionChanged"
                    ToolTip="这一路自己的压缩（管忽大忽小）；混完之后还有一道「输出总线压缩」"/>
        </Grid>
      </Border>

      <!-- 通道 5 -->
      <Border Style="{StaticResource ChBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="58"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
            <TextBlock Text="5" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ComboBox Grid.Column="1" x:Name="Dev5" Margin="6,0" Background="{DynamicResource Brush.Bg.Surface}"
                    SelectionChanged="Dev_SelectionChanged"/>
          <ComboBox Grid.Column="2" x:Name="Role5" Style="{StaticResource RoleBox}"
                    SelectionChanged="Role_SelectionChanged" Tag="5"/>
          <ToggleButton Grid.Column="3" x:Name="Pwr5" Style="{StaticResource PwrBtn}" Tag="5"
                        Checked="Pwr_Changed" Unchecked="Pwr_Changed"/>
          <Slider Grid.Column="4" x:Name="Vol5" Minimum="0" Maximum="200" Value="100"
                  Margin="4,0" ValueChanged="Vol_ValueChanged" Tag="5"/>
          <TextBlock Grid.Column="5" x:Name="Vol5Text" Text="0.0 dB" Style="{StaticResource Lbl}"/>
          <CheckBox Grid.Column="6" x:Name="Mut5" Content="静音" Foreground="{DynamicResource Brush.Text.Secondary}"
                    VerticalAlignment="Center" Checked="Mut_Changed" Unchecked="Mut_Changed" Tag="5"/>
          <ComboBox Grid.Column="7" x:Name="Cmp5" Height="22" FontSize="10" Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Bg.Surface}" Tag="5"
                    SelectionChanged="Cmp_SelectionChanged"
                    ToolTip="这一路自己的压缩（管忽大忽小）；混完之后还有一道「输出总线压缩」"/>
        </Grid>
      </Border>

      <!-- 通道 6 -->
      <Border Style="{StaticResource ChBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="58"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sunken}">
            <TextBlock Text="6" Foreground="{DynamicResource Brush.Ok}" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ComboBox Grid.Column="1" x:Name="Dev6" Margin="6,0" Background="{DynamicResource Brush.Bg.Surface}"
                    SelectionChanged="Dev_SelectionChanged"/>
          <ComboBox Grid.Column="2" x:Name="Role6" Style="{StaticResource RoleBox}"
                    SelectionChanged="Role_SelectionChanged" Tag="6"/>
          <ToggleButton Grid.Column="3" x:Name="Pwr6" Style="{StaticResource PwrBtn}" Tag="6"
                        Checked="Pwr_Changed" Unchecked="Pwr_Changed"/>
          <Slider Grid.Column="4" x:Name="Vol6" Minimum="0" Maximum="200" Value="100"
                  Margin="4,0" ValueChanged="Vol_ValueChanged" Tag="6"/>
          <TextBlock Grid.Column="5" x:Name="Vol6Text" Text="0.0 dB" Style="{StaticResource Lbl}"/>
          <CheckBox Grid.Column="6" x:Name="Mut6" Content="静音" Foreground="{DynamicResource Brush.Text.Secondary}"
                    VerticalAlignment="Center" Checked="Mut_Changed" Unchecked="Mut_Changed" Tag="6"/>
          <ComboBox Grid.Column="7" x:Name="Cmp6" Height="22" FontSize="10" Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Bg.Surface}" Tag="6"
                    SelectionChanged="Cmp_SelectionChanged"
