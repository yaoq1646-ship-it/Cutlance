<Window x:Class="Cutlance.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助 · Cutlance" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        TextOptions.TextFormattingMode="Display">
  <!-- 老板 2026-10-20：帮助原来用 MessageBox.Show，70 多行文本把系统弹框撑到 **3385 像素高**
       （屏幕才 1600），下半截完全看不到、也没法滚 —— 实测窗口 rect 高度就是 3385。
       换成这个可滚动的只读文本框：
         · 高度夹进工作区（1366×768@125% 可用高只有 614 DIP）
         · 能滚到每一行，能整段选中复制（出问题可以原样发给我）
         · 等宽字体让键位那几列对得齐 -->
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HintText"
               Text="下面的文字可以选中、复制（Ctrl+C）；全部键位都能在「设置 → 导播键盘 / 快捷键…」里改。"
               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11"
               TextWrapping="Wrap" Margin="0,0,0,8"/>

    <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Sunken}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3">
      <TextBox x:Name="Body" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               Background="Transparent" BorderThickness="0"
               Foreground="{DynamicResource Brush.Text}"
               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
               FontSize="12.5" Padding="10,8"
               CaretBrush="{DynamicResource Brush.Accent}"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource BtnPrimary}"
              Width="96" Height="32" IsCancel="True" Click="BtnClose_Click"/>
    </StackPanel>
  </Grid>
</Window>
