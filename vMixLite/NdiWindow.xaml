<Window x:Class="Cutlance.NdiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NDI 输入 — 局域网源发现" Height="700" Width="760" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        Style="{StaticResource AppWindow}">
  <Window.Resources>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <!-- 错误信息（尤其展开后的内层异常）可能很长，必须换行，否则被裁掉等于没报 -->
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 输入框：深色主题下 WPF 默认模板的边框/背景偏亮，统一自绘 -->
    <!-- 按钮：WPF 默认模板会退化成系统浅色底（白底浅字根本读不出）→ 自绘，
         背景一律取 Button.Background，禁用态改半透明而不是变白。 -->
  </Window.Resources>

  <!-- 内容整体可滚：小屏（1080p@150% 可用高 693 DIP、1366x768@125% 仅 582 DIP）下窗口会被
       Services/WindowFit 收敛到可用区，收敛后靠这里滚动，保证每一项都够得到。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <!-- ⚠ 必须是确定高度：ScrollViewer 以无穷高度测量内容，Height="*" 会退化成 Auto，
           列表会按内容全展开把整窗撑爆（CaptureSignal / NetworkStream 踩过同一个坑）。 -->
      <RowDefinition Height="220"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource SectTitle}" Text="① 发现局域网里的 NDI 源"/>

    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="刷新" Width="84"
              Background="{DynamicResource Brush.Ok.Dim}" Click="BtnRefresh_Click"/>
      <TextBlock x:Name="TxtStatus" Style="{StaticResource Lbl}" VerticalAlignment="Center"
                 Text="正在扫描…"/>
    </DockPanel>

    <ListBox Grid.Row="2" x:Name="LstSources" Background="{DynamicResource Brush.Bg.Overlay}" BorderBrush="{DynamicResource Brush.Border}"
             BorderThickness="1" SelectionChanged="LstSources_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontSize="12"/>
            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="3" x:Name="TxtInfo" Style="{StaticResource Hint}" Margin="0,8,0,0"
               Text="选中一个源，再点「检测」可先看看它出的是什么画面规格。"/>

    <StackPanel Grid.Row="4" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource SectTitle}" Text="② 额外发现 IP（跨机找不到源时填，逗号分隔）"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="BtnApplyIps" Content="应用" Width="70"
                Margin="6,0,0,0" Click="BtnApplyIps_Click"/>
        <TextBox x:Name="TxtExtraIps" Height="28"
                 ToolTip="填对方的 IP，例如 192.168.3.50。NDI 会直接向该机的 5960 端口要源列表，绕开 mDNS。"/>
      </DockPanel>
      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                 Text="本机源已自动包含（127.0.0.1 + 本机各网卡地址）。只有当对方机器的 NDI 源刷不出来时才需要填。"/>
    </StackPanel>

    <StackPanel Grid.Row="5" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource SectTitle}" Text="③ 手动输入源名（列表里找不到时用）"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="BtnTest" Content="检测" Width="70"
                Margin="6,0,0,0" Click="BtnTest_Click"/>
        <TextBox x:Name="TxtManual" Height="28"/>
      </DockPanel>
      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                 Text="源名形如「主机名 (源名)」，例如 PC-01 (Camera 1)。源名带中文或空格都能识别；复制粘贴即可。"/>
    </StackPanel>

    <DockPanel Grid.Row="6" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="关闭" Width="90"
              Margin="8,0,0,0" Click="BtnClose_Click"/>
      <Button DockPanel.Dock="Right" x:Name="BtnAdd" Content="添加为输入" Width="120"
              Background="{DynamicResource Brush.Ok.Dim}" Click="BtnAdd_Click"/>
      <TextBlock x:Name="TxtNote" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
  </ScrollViewer>
</Window>
